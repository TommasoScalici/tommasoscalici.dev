---
interface Props {
    gaId?: string;
    fbPixelId?: string;
    tiktokPixelId?: string;
}

import analyticsScript from '../scripts/analytics.js?raw';

const { gaId, fbPixelId, tiktokPixelId } = Astro.props;
const hasAnalytics = [gaId, fbPixelId, tiktokPixelId].some((id) => !!id);
---

<!-- Analytics Configuration -->{
    hasAnalytics && (
        <>
            <script
                is:inline
                set:html={`
                window.ANALYTICS_CONFIG = {
                    gaId: ${JSON.stringify(gaId)},
                    fbPixelId: ${JSON.stringify(fbPixelId)},
                    tiktokPixelId: ${JSON.stringify(tiktokPixelId)},
                };
            `}
            />
            <script is:inline set:html={analyticsScript} />
        </>
    )
}

<!-- Google Analytics 4 (Async Loader) -->
{gaId && <script is:inline async src={`https://www.googletagmanager.com/gtag/js?id=${gaId}`} />}
