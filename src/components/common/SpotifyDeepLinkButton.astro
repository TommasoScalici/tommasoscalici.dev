---
import { Icon } from 'astro-icon/components';

interface Props {
    playlistId: string;
    eventName: string;
    className?: string;
}

const { playlistId, eventName, className = '' } = Astro.props;
const webUrl = `https://open.spotify.com/playlist/${playlistId}`;
---

<a
    href={webUrl}
    data-spotify-deep-link
    data-playlist-id={playlistId}
    data-event-name={eventName}
    class={`group flex w-full cursor-pointer select-none no-underline transform animate-shake items-center justify-center gap-3 rounded-full bg-spotify px-8 py-4 font-bold text-black shadow-spotify-glow transition-all hover:scale-105 hover:bg-spotify-hover hover:shadow-spotify-glow-hover ${className}`}
    style="animation-delay: 3s;"
>
    <Icon name="simple-icons:spotify" class="h-6 w-6" />
    <span class="label-text tracking-wide">OPEN IN SPOTIFY</span>
</a>

<script>
    class SpotifyDeepLinkManager {
        constructor() {
            const links = document.querySelectorAll<HTMLAnchorElement>(
                '[data-spotify-deep-link]:not([data-initialized])',
            );
            const userAgent = navigator.userAgent || '';
            const isAndroid = /Android/i.test(userAgent);
            const isIOS = /iPhone|iPad|iPod/i.test(userAgent);

            for (const link of links) {
                link.setAttribute('data-initialized', 'true');
                const playlistId = link.getAttribute('data-playlist-id');
                if (!playlistId) continue;

                const webUrl = `https://open.spotify.com/playlist/${playlistId}`;
                const encodedWebUrl = encodeURIComponent(webUrl);

                if (isAndroid) {
                    // Valid Android Intent targeting com.spotify.music with HTTPS scheme and fallback
                    link.href = `intent://open.spotify.com/playlist/${playlistId}#Intent;package=com.spotify.music;scheme=https;S.browser_fallback_url=${encodedWebUrl};end`;
                } else if (isIOS) {
                    // iOS direct URI scheme for the Spotify app
                    link.href = `spotify:playlist:${playlistId}`;
                } else {
                    link.href = webUrl;
                    link.target = '_blank';
                    link.rel = 'noopener noreferrer';
                }

                link.addEventListener('click', this.#handleClick);
            }
        }

        #handleClick = (e: MouseEvent) => {
            const link = e.currentTarget as HTMLAnchorElement;
            const playlistId = link.getAttribute('data-playlist-id');
            const eventName = link.getAttribute('data-event-name') || 'Spotify Playlist';
            const labelEl = link.querySelector('.label-text');

            if (labelEl) labelEl.textContent = 'Opening...';
            link.classList.add('cursor-wait', 'opacity-75');

            // 1. Fire Meta Pixel Conversion Event immediately
            if (typeof window !== 'undefined' && typeof window.fbq === 'function') {
                window.fbq('track', 'ViewContent', {
                    content_name: eventName,
                    content_category: 'Spotify Playlist Deep Link',
                });
            }

            // 2. Fire GA4 Conversion Event immediately
            if (typeof window !== 'undefined' && typeof window.gtag === 'function') {
                window.gtag('event', 'select_content', {
                    content_type: 'spotify_playlist',
                    item_id: playlistId,
                    content_name: eventName,
                });
            }

            const userAgent = navigator.userAgent || '';
            const isIOS = /iPhone|iPad|iPod/i.test(userAgent);

            // On iOS, fallback to web player if the app is not installed
            if (isIOS) {
                const webUrl = `https://open.spotify.com/playlist/${playlistId}`;
                setTimeout(() => {
                    if (!document.hidden) {
                        window.location.href = webUrl;
                    }
                }, 1500);
            }

            setTimeout(() => {
                link.classList.remove('cursor-wait', 'opacity-75');
                if (labelEl) labelEl.textContent = 'OPEN IN SPOTIFY';
            }, 2500);
        };
    }

    const initSpotifyDeepLink = () => {
        new SpotifyDeepLinkManager();
    };

    if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', initSpotifyDeepLink);
    } else {
        initSpotifyDeepLink();
    }
    document.addEventListener('astro:page-load', initSpotifyDeepLink);
</script>
