---
import { Picture } from 'astro:assets';
import { Icon } from 'astro-icon/components';

import { platformOrder, platforms } from '../../data/platforms';
import type { MusicRelease, PlatformLinks } from '../../data/types';
import SmartLinkDialog, { type SmartLink } from '../dialogs/SmartLinkDialog.astro';

interface Props {
    release: MusicRelease;
    t: Record<string, string>;
}

const { release, t } = Astro.props;

const isUpcoming = release.isUpcoming;

const albumLinks: SmartLink[] = platformOrder
    .map((platformKey) => {
        const url = release.links?.[platformKey as keyof PlatformLinks];
        const platformDef = platforms[platformKey];
        if (!url) return null;
        return {
            ...platformDef,
            url: url,
        };
    })
    .filter((link): link is SmartLink => link !== null);

const dialogId = `dialog-${release.title.toLowerCase().replace(/[^a-z0-9]/g, '-')}`;
const trackingId = release.title.toLowerCase().replace(/[^a-z0-9]/g, '-');
---

<div
    class="border-glass-border group shadow-glass-light hover:border-secondary/50 hover:shadow-secondary-glow relative aspect-square overflow-hidden rounded-2xl border bg-white/70 backdrop-blur-xl transition-all duration-300 dark:border-white/10 dark:bg-white/5 dark:shadow-none"
>
    {
        isUpcoming && (
            <div class="border-primary text-primary shadow-primary-glow absolute top-0 right-0 z-10 m-4 rounded-md border bg-black/50 px-3 py-1 text-xs font-bold uppercase backdrop-blur-sm">
                {t['card.comingSoon']}
            </div>
        )
    }

    <Picture
        src={release.coverImage}
        alt={release.title}
        width={300}
        height={300}
        formats={['avif', 'webp']}
        loading="lazy"
        class={`absolute inset-0 h-full w-full object-cover transition-transform duration-700 ${
            isUpcoming
                ? 'scale-100 opacity-40 grayscale'
                : 'opacity-80 group-hover:scale-110 group-hover:opacity-100'
        }`}
    />

    <div
        class={`absolute inset-0 bg-linear-to-t from-black via-black/50 to-transparent opacity-90 transition-opacity duration-500 ${!isUpcoming ? 'group-hover:opacity-30' : ''}`}
    >
    </div>

    <div
        class="absolute inset-0 flex flex-col justify-end p-6 drop-shadow-md transition-all duration-300 group-hover:drop-shadow-xl"
    >
        <div
            class="translate-y-4 transform transition-transform duration-500 group-hover:translate-y-0"
        >
            <span
                class="text-secondary group-hover:text-primary mb-1 block font-mono text-xs tracking-wider uppercase transition-all duration-300 group-hover:font-bold"
            >
                {release.genre}
                {release.year ? ` • ${release.year}` : ''}
            </span>
            <h3 class="mb-1 text-2xl leading-tight font-bold text-white">
                {release.title}
            </h3>
            <p class="mb-4 text-sm text-gray-400">{release.type}</p>

            <button
                type="button"
                data-release-btn
                data-dialog-id={isUpcoming ? undefined : dialogId}
                data-presave={isUpcoming ? release.presaveLink : undefined}
                data-track-name={release.title}
                data-track-id={trackingId}
                disabled={isUpcoming && !release.presaveLink}
                class={`inline-flex transform items-center gap-2 rounded-full bg-secondary/90 px-4 py-2 text-sm font-semibold text-white transition-all duration-300 border-none outline-none ${
                    isUpcoming && !release.presaveLink
                        ? 'translate-y-0 cursor-not-allowed bg-gray-700 text-gray-400 opacity-100 hover:bg-gray-700'
                        : 'translate-y-4 opacity-0 hover:scale-105 hover:bg-secondary hover:shadow-[0_0_25px_rgba(255,255,255,0.6)] hover:brightness-110 group-hover:translate-y-0 group-hover:opacity-100'
                }`}
            >
                {
                    isUpcoming ? (
                        release.presaveLink ? (
                            <>
                                <Icon
                                    name="lucide:play"
                                    class="h-4 w-4 fill-current transition-transform group-hover:scale-110"
                                />
                                <span>{t['card.presave']}</span>
                            </>
                        ) : (
                            <span>
                                {t['card.comingYear']} {release.year}
                            </span>
                        )
                    ) : (
                        <>
                            <Icon
                                name="lucide:play"
                                class="h-4 w-4 fill-current transition-transform group-hover:scale-110"
                            />
                            <span>{t['card.listenNow']}</span>
                        </>
                    )
                }
            </button>
        </div>
    </div>
</div>

{
    !isUpcoming && (
        <SmartLinkDialog
            id={dialogId}
            title={t['dialog.choosePlatform'] || 'Choose Platform'}
            links={albumLinks}
            trackingType="music_release"
            trackingName={release.title}
            trackingId={trackingId}
        />
    )
}

<script>
    import { trackEvent } from '../../lib/analytics';

    class MusicReleaseManager {
        constructor() {
            const btns = document.querySelectorAll<HTMLButtonElement>('[data-release-btn]');
            for (const btn of btns) {
                btn.addEventListener('click', this.#handleClick);
            }
        }

        #handleClick = (e: MouseEvent) => {
            e.preventDefault();
            const btn = e.currentTarget as HTMLButtonElement;
            const presaveUrl = btn.getAttribute('data-presave');
            const dialogId = btn.getAttribute('data-dialog-id');
            const trackName = btn.getAttribute('data-track-name') || '';
            const trackId = btn.getAttribute('data-track-id') || '';

            if (presaveUrl) {
                window.open(presaveUrl, '_blank', 'noopener,noreferrer');
                return;
            }

            if (dialogId) {
                trackEvent('select_content', {
                    content_type: 'music_release',
                    content_name: trackName,
                    content_ids: [trackId],
                });

                const dialog = document.getElementById(dialogId) as HTMLDialogElement | null;
                if (dialog) {
                    dialog.showModal();
                }
            }
        };
    }

    document.addEventListener('astro:page-load', () => {
        new MusicReleaseManager();
    });
</script>
