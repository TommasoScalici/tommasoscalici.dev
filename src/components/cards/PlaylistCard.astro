---
import { Icon } from 'astro-icon/components';

interface Playlist {
    title: string;
    description: string;
    coverImage: string;
    coverImageSet?: {
        avif: string;
        webp: string;
    };
    spotifyId: string;
    genre: string;
}

interface Props {
    playlist: Playlist;
    t: Record<string, string>;
}

const { playlist, t } = Astro.props;
---

<a
    data-playlist-link
    data-playlist-title={playlist.title}
    href={playlist.spotifyId ? `https://open.spotify.com/playlist/${playlist.spotifyId}` : '#'}
    target="_blank"
    rel="noopener noreferrer"
    class="border-glass-border group relative aspect-square overflow-hidden rounded-2xl border bg-white/70 shadow-glass-light backdrop-blur-xl transition-all duration-300 hover:border-primary/50 hover:shadow-primary-glow dark:border-white/10 dark:bg-white/5 dark:shadow-none"
>
    <!-- Background Image -->
    <picture class="absolute inset-0 h-full w-full">
        {
            playlist.coverImageSet && (
                <>
                    <source srcset={playlist.coverImageSet.avif} type="image/avif" />
                    <source srcset={playlist.coverImageSet.webp} type="image/webp" />
                </>
            )
        }
        <img
            src={playlist.coverImageSet ? playlist.coverImageSet.webp : playlist.coverImage}
            alt={playlist.title}
            width={320}
            height={180}
            loading="lazy"
            class="h-full w-full object-cover opacity-80 transition-all duration-500 group-hover:scale-105 group-hover:opacity-40"
        />
    </picture>

    <!-- Gradient Overlay -->
    <div class="absolute inset-0 bg-gradient-to-t from-black via-black/40 to-transparent"></div>

    <!-- Content Overlay -->
    <div class="absolute inset-0 z-10 flex flex-col justify-end p-6">
        <span class="mb-1 font-mono text-xs text-primary">{playlist.genre}</span>
        <h3 class="mb-1 text-xl font-bold leading-tight text-white">
            {playlist.title}
        </h3>
        <p class="line-clamp-2 text-xs text-gray-400">{playlist.description}</p>
    </div>

    <!-- Hover Overlay with Icon -->
    <div
        class="absolute inset-0 z-20 flex items-center justify-center bg-black/60 opacity-0 backdrop-blur-[2px] transition-opacity duration-300 group-hover:opacity-100"
    >
        <div
            class="flex translate-y-4 transform flex-col items-center gap-2 transition-transform duration-300 group-hover:translate-y-0"
        >
            <Icon
                name="simple-icons:spotify"
                class="h-12 w-12 text-spotify drop-shadow-[0_0_15px_rgba(29,185,84,0.6)]"
            />
            <span
                class="animate-text-shimmer bg-gradient-to-r from-spotify via-white to-spotify bg-clip-text text-sm font-bold tracking-widest text-transparent"
            >
                {t['card.playOnSpotify']}
            </span>
        </div>
    </div>

    <!-- Top Right Badge -->
    <div
        class="border-glass-border/10 absolute right-0 top-0 m-3 rounded border bg-black/50 px-2 py-1 font-mono text-[10px] text-gray-300 backdrop-blur-md"
    >
        PLAYLIST
    </div>
</a>

<script>
    class PlaylistLink {
        constructor() {
            const links = document.querySelectorAll<HTMLAnchorElement>('[data-playlist-link]');
            for (const link of links) {
                link.addEventListener('click', this.#handleClick);
            }
        }

        #handleClick = (e: MouseEvent) => {
            const el = e.currentTarget as HTMLAnchorElement;
            const title = el.getAttribute('data-playlist-title');
            if (typeof window !== 'undefined' && window.fbq && title) {
                window.fbq('track', 'ViewContent', {
                    content_name: title,
                    content_category: 'Spotify Playlist',
                });
            }
        };
    }
    // Initialize once
    if (!window.customElements.get('playlist-link-init')) {
        new PlaylistLink();
    }
</script>
