---
import { Icon } from 'astro-icon/components';

import type { Project } from '../../data/types';

interface Props {
    project: Project;
}

const { project } = Astro.props;
---

<div
    class="border-glass-border group relative flex h-full flex-col overflow-hidden rounded-2xl border bg-white/70 shadow-glass-light backdrop-blur-xl transition-all duration-300 hover:border-primary/50 hover:shadow-[0_0_30px_rgba(0,243,255,0.15)] dark:border-white/10 dark:bg-white/5 dark:shadow-none"
>
    <div class="relative flex h-full flex-col p-6">
        <!-- Hover Gradient Effect -->
        <div
            class="pointer-events-none absolute inset-0 bg-gradient-to-br from-primary/5 to-transparent opacity-0 transition-opacity duration-500 group-hover:opacity-100"
        >
        </div>

        <div class="relative z-10 flex h-full flex-col">
            <div class="mb-4 flex items-start justify-between">
                <div
                    class="rounded-lg border border-surface bg-background/50 p-3 transition-colors group-hover:border-primary/30"
                >
                    <Icon name="lucide:code" class="h-6 w-6 text-primary" />
                </div>
                <div class="flex gap-2">
                    {
                        project.repoUrl && (
                            <a
                                href={project.repoUrl}
                                target="_blank"
                                rel="noopener noreferrer"
                                class="rounded-full p-2 text-muted transition-colors hover:bg-glass-bg/5 hover:text-white"
                                aria-label="View Source Code"
                            >
                                <Icon name="simple-icons:github" class="h-5 w-5" />
                            </a>
                        )
                    }
                    {
                        project.playStoreUrl && (
                            <a
                                href={project.playStoreUrl}
                                target="_blank"
                                rel="noopener noreferrer"
                                class="rounded-full p-2 text-muted transition-colors hover:bg-glass-bg/5 hover:text-white"
                                aria-label="View on Google Play"
                            >
                                <Icon name="simple-icons:googleplay" class="h-5 w-5" />
                            </a>
                        )
                    }
                    {
                        project.demoUrl && (
                            <a
                                href={project.demoUrl}
                                target="_blank"
                                rel="noopener noreferrer"
                                class="rounded-full p-2 text-muted transition-colors hover:bg-glass-bg/5 hover:text-white"
                                aria-label="View Live Demo"
                            >
                                <Icon name="lucide:external-link" class="h-5 w-5" />
                            </a>
                        )
                    }
                </div>
            </div>

            <h3
                class="mb-2 font-mono text-xl font-bold text-main transition-colors group-hover:text-primary"
            >
                {project.title}
            </h3>

            <p class="mb-6 flex-grow text-sm leading-relaxed text-muted">
                {project.description}
            </p>

            <div class="mt-auto flex flex-wrap gap-2">
                {
                    project.techStack.map((tech) => (
                        <span class="rounded-full border border-surface bg-black/5 px-3 py-1 font-mono text-xs font-semibold text-muted transition-colors group-hover:border-primary/20 group-hover:text-primary/90 dark:bg-white/5">
                            {tech}
                        </span>
                    ))
                }
            </div>
        </div>
    </div>
</div>
