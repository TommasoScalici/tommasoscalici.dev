---
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';
import { Icon } from 'astro-icon/components';

import ThemeToggle from './ThemeToggle.astro';

interface Props {
    lang: string;
    t: Record<string, string>;
    navItems: { label: string; href: string }[];
    logoSrc: ImageMetadata;
    targetLangUrl: string;
}

const { lang, t, navItems, logoSrc, targetLangUrl } = Astro.props;
---

<site-header>
    <header
        class="border-surface bg-background/70 fixed top-0 right-0 left-0 z-50 border-b backdrop-blur-xl"
    >
        <div class="mx-auto flex h-16 max-w-7xl items-center justify-between px-6">
            <a
                href={lang === 'en' ? '/' : `/${lang}/`}
                class="group flex items-center font-mono text-xl font-bold tracking-tighter transition-colors"
            >
                <Image
                    src={logoSrc}
                    alt="TS Circuit Logo"
                    width={48}
                    height={48}
                    loading="eager"
                    class="mr-3 h-12 w-auto object-contain"
                />
                <div class="flex flex-col leading-none sm:flex-row sm:leading-normal">
                    <span class="text-main group-hover:text-primary transition-colors">
                        TOMMASO
                    </span>
                    <span class="text-main group-hover:text-secondary transition-colors sm:ml-2">
                        SCALICI
                    </span>
                </div>
            </a>

            <!-- Desktop Nav -->
            <nav class="hidden items-center gap-8 lg:flex">
                {
                    navItems.map((item) => (
                        <a
                            href={item.href}
                            class="text-muted hover:text-main text-sm font-semibold transition-colors hover:drop-shadow-[0_0_8px_rgba(0,243,255,0.5)]"
                        >
                            {item.label}
                        </a>
                    ))
                }
            </nav>

            <!-- Mobile/Tablet Controls -->
            <div class="flex items-center gap-4">
                <!-- Submit Your Music CTA (Desktop) -->
                <a
                    href="https://submitl.ink/c/tommasoscalici"
                    target="_blank"
                    rel="noopener noreferrer"
                    data-track-cta="Submit Music Header"
                    class="cta-shimmer group hover:shadow-primary-glow relative hidden items-center justify-center overflow-hidden rounded-full p-px transition-all hover:scale-105 md:flex"
                >
                    <span
                        class="flex items-center gap-2 rounded-full bg-black px-4 py-1.5 transition-colors group-hover:bg-transparent"
                    >
                        <Icon name="lucide:music" class="text-primary h-3.5 w-3.5" />
                        <span
                            class="font-mono text-[10px] font-bold tracking-tight whitespace-nowrap"
                        >
                            {t['nav.submitMusic']}
                        </span>
                    </span>
                </a>

                <!-- Utility Buttons -->
                <div class="hidden items-center gap-4 border-l border-white/10 pl-6 md:flex">
                    <a
                        href={targetLangUrl}
                        data-lang-switch
                        data-astro-scroll="manual"
                        data-astro-history="replace"
                        class="border-glass-border text-muted hover:border-primary/50 hover:text-primary flex items-center gap-2 rounded-full border bg-white/70 px-3 py-1.5 font-mono text-xs transition-all dark:border-white/10 dark:bg-white/5"
                        aria-label="Switch Language"
                    >
                        <Icon name="lucide:languages" class="h-3.5 w-3.5" />
                        <span>{lang === 'en' ? 'IT' : 'EN'}</span>
                    </a>

                    <ThemeToggle />

                    <button
                        type="button"
                        data-cookie-btn
                        class="text-muted hover:text-primary transition-colors"
                        aria-label="Cookie Settings"
                    >
                        <Icon name="lucide:cookie" class="h-5 w-5" />
                    </button>
                </div>

                <!-- Hamburger/Mobile CTA -->
                <div class="flex items-center gap-4 lg:hidden">
                    <!-- Submit Your Music CTA (Mobile) -->
                    <a
                        href="https://submitl.ink/c/tommasoscalici"
                        target="_blank"
                        rel="noopener noreferrer"
                        data-track-cta="Submit Music Header Mobile"
                        class="cta-shimmer group relative flex items-center justify-center overflow-hidden rounded-full p-px transition-all hover:scale-105 active:scale-95 md:hidden"
                    >
                        <span
                            class="flex items-center gap-1.5 rounded-full bg-black px-2.5 py-2 transition-colors sm:gap-2 sm:px-3 sm:py-1.5"
                        >
                            <Icon name="lucide:music" class="text-primary h-3.5 w-3.5" />
                            <span
                                class="max-w-[80px] text-center font-mono text-[9px] leading-[1.1] font-bold tracking-tighter sm:max-w-none sm:text-left sm:text-[10px] sm:leading-tight sm:tracking-tight sm:whitespace-nowrap"
                            >
                                {t['nav.submitMusic']}
                            </span>
                        </span>
                    </a>

                    <button
                        type="button"
                        data-menu-btn
                        class="text-muted hover:text-main"
                        aria-label="Menu"
                        aria-expanded="false"
                    >
                        <Icon name="lucide:menu" class="menu-open-hidden block h-6 w-6" />
                        <Icon name="lucide:x" class="menu-open-block hidden h-6 w-6" />
                    </button>
                </div>
            </div>
        </div>

        <!-- Mobile Nav Overlay -->
        <div
            data-mobile-menu
            class="border-surface slide-in-from-top-5 absolute top-16 right-0 left-0 hidden flex-col border-b bg-black/95 p-6 backdrop-blur-xl lg:hidden"
        >
            <div class="flex flex-col gap-6">
                {
                    navItems.map((item) => (
                        <a
                            href={item.href}
                            class="mobile-nav-link hover:text-primary text-lg font-semibold text-gray-300 transition-colors"
                        >
                            {item.label}
                        </a>
                    ))
                }
            </div>

            <div class="md:hidden">
                <div class="my-6 h-px w-full bg-white/10"></div>

                <div class="flex items-center justify-between gap-4">
                    <a
                        href={targetLangUrl}
                        data-lang-switch
                        data-astro-scroll="manual"
                        data-astro-history="replace"
                        class="border-glass-border text-muted active:border-primary/50 active:text-primary flex items-center gap-2 rounded-full border bg-white/5 px-4 py-2 font-mono text-sm transition-all dark:border-white/10"
                    >
                        <Icon name="lucide:languages" class="h-4 w-4" />
                        <span>{lang === 'en' ? 'Italiano' : 'English'}</span>
                    </a>

                    <div class="flex items-center gap-4">
                        <ThemeToggle />
                        <button
                            type="button"
                            data-cookie-btn
                            data-close-menu
                            class="text-muted active:text-primary rounded-full bg-white/5 p-2 transition-colors"
                            aria-label="Cookie Settings"
                        >
                            <Icon name="lucide:cookie" class="h-5 w-5" />
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </header>
</site-header>

<script>
    import { trackEvent } from '../../lib/analytics';

    class SiteHeader extends HTMLElement {
        #menuBtn: HTMLButtonElement | null = null;
        #mobileMenu: HTMLDivElement | null = null;
        #isOpen: boolean = false;

        connectedCallback() {
            this.#menuBtn = this.querySelector('[data-menu-btn]');
            this.#mobileMenu = this.querySelector('[data-mobile-menu]');

            if (this.#menuBtn && this.#mobileMenu) {
                this.#menuBtn.addEventListener('click', this.#toggleMenu);
            }

            const langSwitches = this.querySelectorAll<HTMLAnchorElement>('[data-lang-switch]');
            for (const langSwitch of langSwitches) {
                langSwitch.addEventListener('click', this.#handleLangSwitch);
            }

            const cookieBtns = this.querySelectorAll<HTMLButtonElement>('[data-cookie-btn]');
            for (const btn of cookieBtns) {
                btn.addEventListener('click', (e) => {
                    e.preventDefault();
                    window.dispatchEvent(new Event('show-cookie-banner'));
                    if (btn.hasAttribute('data-close-menu')) {
                        this.#closeMenu();
                    }
                });
            }

            const mobileNavLinks = this.querySelectorAll<HTMLAnchorElement>('.mobile-nav-link');
            for (const link of mobileNavLinks) {
                link.addEventListener('click', () => this.#closeMenu());
            }

            const ctaLinks = this.querySelectorAll<HTMLAnchorElement>('[data-track-cta]');
            for (const link of ctaLinks) {
                link.addEventListener('click', this.#handleTrackClick);
            }
        }

        #toggleMenu = () => {
            this.#isOpen = !this.#isOpen;
            if (this.#isOpen) {
                this.#mobileMenu?.classList.remove('hidden');
                this.#mobileMenu?.classList.add('flex');
                if (this.#menuBtn) {
                    this.#menuBtn.setAttribute('aria-expanded', 'true');
                    this.#menuBtn.querySelector('.menu-open-hidden')?.classList.add('hidden');
                    this.#menuBtn.querySelector('.menu-open-hidden')?.classList.remove('block');
                    this.#menuBtn.querySelector('.menu-open-block')?.classList.remove('hidden');
                    this.#menuBtn.querySelector('.menu-open-block')?.classList.add('block');
                }
            } else {
                this.#closeMenu();
            }
        };

        #closeMenu = () => {
            this.#isOpen = false;
            this.#mobileMenu?.classList.add('hidden');
            this.#mobileMenu?.classList.remove('flex');
            if (this.#menuBtn) {
                this.#menuBtn.setAttribute('aria-expanded', 'false');
                this.#menuBtn.querySelector('.menu-open-hidden')?.classList.remove('hidden');
                this.#menuBtn.querySelector('.menu-open-hidden')?.classList.add('block');
                this.#menuBtn.querySelector('.menu-open-block')?.classList.add('hidden');
                this.#menuBtn.querySelector('.menu-open-block')?.classList.remove('block');
            }
        };

        #handleLangSwitch = (e: MouseEvent) => {
            const btn = e.currentTarget as HTMLAnchorElement;
            const targetUrl = new URL(btn.href);

            // Save state for seamless restoration in Layout.astro
            sessionStorage.setItem('lang-switch-scroll', window.scrollY.toString());

            if (window.location.hash) {
                sessionStorage.setItem('lang-switch-hash', window.location.hash);
                // Strip hash for the transition to prevent the browser from jump-scrolling
                targetUrl.hash = '';
                btn.href = targetUrl.toString();
            }

            const isItalian = targetUrl.pathname.startsWith('/it');
            const newLang = isItalian ? 'it' : 'en';
            localStorage.setItem('lang', newLang);
        };

        #handleTrackClick = (e: MouseEvent) => {
            const el = e.currentTarget as HTMLAnchorElement;
            const item = el.getAttribute('data-track-cta') || '';
            trackEvent('select_content', {
                content_type: 'cta_button',
                content_name: item,
                item_id: item,
            });
        };
    }

    customElements.define('site-header', SiteHeader);
</script>
