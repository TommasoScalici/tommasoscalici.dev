---
import { Icon } from 'astro-icon/components';

import { artistLinks } from '../../data/artistLinks';
import { secondarySocials } from '../../data/socials';
import SmartLinkDialog from '../dialogs/SmartLinkDialog.astro';
import SocialSmartDialog from '../dialogs/SocialSmartDialog.astro';

interface Props {
    lang: string;
    t: Record<string, string>;
    copyrightDate: string;
}

const { lang, t, copyrightDate } = Astro.props;
---

<footer
    class="border-glass-border dark:border-surface mt-20 border-t bg-white/70 backdrop-blur-md dark:bg-black/50"
>
    <div
        class="mx-auto flex max-w-7xl flex-col items-center gap-8 px-6 py-10 md:flex-row md:justify-between md:py-8"
    >
        <div class="flex flex-col items-center gap-6 md:items-start md:gap-4">
            <p class="text-muted text-center font-mono text-xs sm:text-sm md:text-left">
                &copy; {copyrightDate} Tommaso Scalici. {t['footer.copyright']}
            </p>
            <nav class="flex flex-wrap justify-center gap-3 md:justify-start">
                <a
                    href={lang === 'en' ? '/uses/' : `/${lang}/uses/`}
                    class="border-primary/20 text-primary hover:border-primary/50 hover:bg-primary/10 hover:shadow-primary-glow rounded-full border bg-white/5 px-3 py-1.5 text-xs font-bold tracking-wide shadow-[0_0_10px_rgba(0,243,255,0.1)] transition-all sm:py-1"
                    aria-label={t['footer.uses']}
                >
                    {t['footer.uses']}
                </a>
                <a
                    href={lang === 'en' ? '/privacy-policy/' : `/${lang}/privacy-policy/`}
                    class="border-secondary/20 text-secondary hover:border-secondary/50 hover:bg-secondary/10 hover:shadow-secondary-glow rounded-full border bg-white/5 px-3 py-1.5 text-xs font-bold tracking-wide shadow-[0_0_10px_rgba(255,0,85,0.1)] transition-all sm:py-1"
                    aria-label={t['footer.privacy']}
                >
                    {t['footer.privacy']}
                </a>
                <a
                    href={lang === 'en' ? '/cookie-policy/' : `/${lang}/cookie-policy/`}
                    class="border-secondary/20 text-secondary hover:border-secondary/50 hover:bg-secondary/10 hover:shadow-secondary-glow rounded-full border bg-white/5 px-3 py-1.5 text-xs font-bold tracking-wide shadow-[0_0_10px_rgba(255,0,85,0.1)] transition-all sm:py-1"
                    aria-label={t['cookie.title']}
                >
                    {t['cookie.title']}
                </a>
            </nav>
        </div>

        <div class="flex gap-6">
            <a
                href="https://github.com/TommasoScalici"
                target="_blank"
                rel="noopener noreferrer"
                data-track-footer="GitHub"
                class="text-muted hover:text-primary transition-colors"
                aria-label="GitHub"
            >
                <Icon name="simple-icons:github" class="h-5 w-5" />
            </a>
            <a
                href="https://www.linkedin.com/in/tommasoscalici"
                target="_blank"
                rel="noopener noreferrer"
                data-track-footer="LinkedIn"
                class="text-muted hover:text-primary transition-colors"
                aria-label="LinkedIn"
            >
                <Icon name="simple-icons:linkedin" class="h-5 w-5" />
            </a>

            <button
                type="button"
                data-dialog-trigger="artist-links-dialog"
                class="text-muted hover:text-secondary transition-colors"
                aria-label="Music Platforms"
            >
                <Icon name="lucide:music" class="h-5 w-5" />
            </button>

            <a
                href="https://www.instagram.com/tommasoscalici91"
                target="_blank"
                rel="noopener noreferrer"
                data-track-footer="Instagram"
                class="text-muted hover:text-secondary transition-colors"
                aria-label="Instagram"
            >
                <Icon name="simple-icons:instagram" class="h-5 w-5" />
            </a>

            <button
                type="button"
                data-dialog-trigger="social-links-dialog"
                class="text-muted hover:text-main transition-colors"
                aria-label="More Socials"
            >
                <Icon name="lucide:ellipsis" class="h-5 w-5" />
            </button>
        </div>
    </div>

    <SmartLinkDialog
        id="artist-links-dialog"
        links={artistLinks}
        title={t['dialog.choosePlatform'] || 'Choose Platform'}
        trackingType="artist_profile"
        trackingName="Tommaso Scalici"
        trackingId="tommaso-scalici"
    />

    <SocialSmartDialog
        id="social-links-dialog"
        links={secondarySocials}
        title={t['dialog.connectEverywhere'] || 'Connect'}
        trackingType="social_link"
        trackingName="Tommaso Scalici"
    />
</footer>

<script>
    import { trackEvent } from '../../lib/analytics';

    class FooterManager {
        constructor() {
            const trackLinks = document.querySelectorAll<HTMLAnchorElement>('[data-track-footer]');
            for (const link of trackLinks) {
                link.addEventListener('click', this.#handleTrackClick);
            }

            const dialogTriggers =
                document.querySelectorAll<HTMLButtonElement>('[data-dialog-trigger]');
            for (const btn of dialogTriggers) {
                btn.addEventListener('click', this.#handleDialogOpen);
            }
        }

        #handleTrackClick = (e: MouseEvent) => {
            const el = e.currentTarget as HTMLAnchorElement;
            const item = el.getAttribute('data-track-footer') || '';
            trackEvent('select_content', {
                content_type: 'social_link',
                content_name: item,
                item_id: item,
            });
        };

        #handleDialogOpen = (e: MouseEvent) => {
            const el = e.currentTarget as HTMLButtonElement;
            const dialogId = el.getAttribute('data-dialog-trigger');
            if (dialogId) {
                const dialog = document.getElementById(dialogId) as HTMLDialogElement | null;
                if (dialog) dialog.showModal();
            }
        };
    }

    document.addEventListener('astro:page-load', () => {
        new FooterManager();
    });
</script>
