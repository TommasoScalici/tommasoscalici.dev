---
import { type CollectionEntry, getCollection } from 'astro:content';

import { defaultLang, ui } from '../../i18n/ui';
import { getLocalizedContent } from '../../lib/i18n-utils';
import ProjectCard from '../cards/ProjectCard.astro';

const projects = await getCollection('projects');
// Sort by title or any other criteria if needed. For now default sort.

const { lang = defaultLang } = Astro.props;
const t = lang in ui ? ui[lang as keyof typeof ui] : ui[defaultLang];

type ProjectEntry = CollectionEntry<'projects'>;

const localizedProjects = projects.map((project: ProjectEntry) => {
    const data = project.data;
    const title = getLocalizedContent(data.title, lang, defaultLang);
    const description = getLocalizedContent(data.description, lang, defaultLang);

    let demoUrl: string | undefined;
    if (typeof data.demoUrl === 'string') {
        demoUrl =
            data.demoUrl.startsWith('/') && lang === 'it' ? `/it${data.demoUrl}` : data.demoUrl;
    } else if (data.demoUrl) {
        const localized = getLocalizedContent(data.demoUrl, lang, defaultLang);
        demoUrl = localized || undefined;
    }

    return {
        ...data,
        title,
        description,
        demoUrl,
    };
});
---

<section id="projects" class="bg-white/50 px-6 py-32 dark:bg-transparent">
    <div class="mx-auto max-w-7xl">
        <div class="mb-16 flex items-end justify-between">
            <div>
                <h2
                    class="mb-4 font-mono text-4xl font-bold md:text-5xl"
                    transition:name="projects-header"
                >
                    <span class="text-primary">01.</span>
                    {t['section.projects.title']}
                </h2>
                <p class="text-muted">{t['section.projects.subtitle']}</p>
            </div>
        </div>

        <div class="grid grid-cols-1 gap-6 md:grid-cols-2 lg:grid-cols-3">
            {localizedProjects.map((project) => (
                <ProjectCard
                    project={project}
                    labels={{
                        viewSource: t['aria.viewSource'],
                        viewPlayStore: t['aria.viewPlayStore'],
                        viewProject: t['aria.viewProject'],
                    }}
                />
            ))}
        </div>
    </div>
</section>
