---
import { projects } from '../../data/projects';
import { ProjectCard } from '../ProjectCard';
import { ui, defaultLang } from '../../i18n/ui';

interface Props {
    lang?: string;
}

const { lang = defaultLang } = Astro.props;
const t = ui[lang as keyof typeof ui] || ui[defaultLang];
---

<section id="projects" class="bg-black/50 px-6 py-32">
    <div class="mx-auto max-w-7xl">
        <div class="mb-16 flex items-end justify-between">
            <div>
                <h2 class="mb-4 font-mono text-4xl font-bold md:text-5xl">
                    <span class="text-primary">01.</span>
                    {t['section.projects.title']}
                </h2>
                <p class="text-gray-400">
                    {t['section.projects.subtitle']}
                </p>
            </div>
        </div>

        <div class="grid grid-cols-1 gap-6 md:grid-cols-2 lg:grid-cols-3">
            {projects.map((project) => <ProjectCard client:visible project={project} />)}
        </div>
    </div>
</section>
