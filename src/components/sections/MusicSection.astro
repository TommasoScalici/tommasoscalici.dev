---
import { getImage } from 'astro:assets';
import { type CollectionEntry, getCollection } from 'astro:content';

import { defaultLang, ui } from '../../i18n/ui';
import { MusicReleaseCard } from '../MusicReleaseCard';

const musicReleases = await getCollection('music');

interface Props {
    lang: string;
}

const { lang } = Astro.props;
const t = lang in ui ? ui[lang as keyof typeof ui] : ui[defaultLang];

// Optimize Music Images
const optimizedMusicReleases = await Promise.all(
    musicReleases.map(async (release: CollectionEntry<'music'>) => {
        const webpImage = await getImage({
            src: release.data.coverImage,
            format: 'webp',
            width: 300,
            height: 300,
        });
        const avifImage = await getImage({
            src: release.data.coverImage,
            format: 'avif',
            width: 300,
            height: 300,
        });
        return {
            ...release.data,
            coverImage: webpImage.src,
            coverImageSet: {
                webp: webpImage.src,
                avif: avifImage.src,
            },
        };
    }),
);
---

<section id="music" class="relative overflow-hidden px-6 py-32">
    {/* Background Gradient */}
    <div
        class="pointer-events-none absolute inset-0 bg-gradient-to-b from-transparent via-secondary/5 to-transparent"
    >
    </div>

    <div class="relative z-10 mx-auto max-w-7xl">
        <div class="mb-16 flex items-end justify-between">
            <div>
                <h2 class="mb-4 font-mono text-4xl font-bold md:text-5xl">
                    <span class="text-secondary">02.</span>
                    {t['section.music.title']}
                </h2>
                <p class="text-muted">
                    {t['section.music.subtitle']}
                </p>
            </div>
        </div>

        <div class="grid grid-cols-1 gap-8 sm:grid-cols-2 lg:grid-cols-3">
            {
                optimizedMusicReleases.map((release) => (
                    <MusicReleaseCard client:visible release={release} t={t} />
                ))
            }
        </div>
    </div>
</section>
