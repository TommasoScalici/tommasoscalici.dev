---
import { Image } from 'astro:assets';
import { getEntry } from 'astro:content';

import profileImage from '../../assets/profile.webp';

interface Props {
    lang: string;
}

const { lang } = Astro.props;
import { defaultLang, ui } from '../../i18n/ui';

const t = lang in ui ? ui[lang as keyof typeof ui] : ui[defaultLang];
const bioEntry = await getEntry('bio', lang);

if (!bioEntry) {
    throw new Error(`Bio entry for locale ${lang} not found.`);
}

const bio = bioEntry.data;
---

<section class="relative flex min-h-screen flex-col">
    <div class="flex flex-grow flex-col justify-center px-6 pt-16">
        <div class="mx-auto w-full max-w-7xl">
            <div class="grid grid-cols-1 items-center gap-8 md:grid-cols-[3fr_2fr] lg:gap-12">
                {/* Text Content */}
                <div class="max-w-4xl">
                    <h1
                        class="mb-8 font-mono text-4xl font-bold leading-none tracking-tighter md:text-5xl lg:text-7xl"
                    >
                        <span
                            class="block animate-pulse bg-gradient-to-r from-gray-600 via-primary to-blue-400 bg-clip-text pb-2 text-transparent dark:from-white dark:via-primary dark:to-blue-400"
                        >
                            {bio.heroTitle}
                        </span>
                        <span
                            class="block animate-pulse bg-gradient-to-r from-gray-600 via-secondary to-purple-500 bg-clip-text pb-2 text-transparent dark:from-white dark:via-secondary dark:to-purple-500"
                        >
                            {bio.heroSubtitle}
                        </span>
                    </h1>

                    <p
                        class="mb-10 max-w-2xl border-l-2 border-primary/50 pl-6 text-xl leading-relaxed text-muted md:text-2xl"
                    >
                        {bio.description}
                    </p>

                    <div class="flex flex-wrap gap-4">
                        <a
                            href="#projects"
                            class="rounded-full border border-primary px-8 py-3 font-bold text-primary transition-all duration-300 hover:bg-primary/10 hover:shadow-primary-glow"
                        >
                            {t['hero.viewProjects']}
                        </a>
                        <a
                            href="#music"
                            class="rounded-full border border-secondary px-8 py-3 font-bold text-secondary transition-all duration-300 hover:bg-secondary/10 hover:shadow-secondary-glow"
                        >
                            {t['hero.listenMusic']}
                        </a>
                        <a
                            href="#playlists"
                            class="border-glass-border hover:border-glass-border/30 rounded-full border bg-white/70 px-8 py-3 font-bold text-muted transition-all duration-300 hover:bg-glass-bg/15 hover:text-main dark:border-white/10 dark:bg-white/5"
                        >
                            {t['hero.enterFlow']}
                        </a>
                    </div>
                </div>

                {/* Profile Image */}
                <div
                    class="animate-float relative order-first mb-8 flex items-center justify-center md:order-last md:mb-0 md:justify-end"
                >
                    <div class="relative h-48 w-48 md:h-64 md:w-64 lg:h-80 lg:w-80 xl:h-96 xl:w-96">
                        {/* Glow Effect */}
                        <div
                            class="absolute inset-0 rotate-6 transform rounded-[2rem] bg-gradient-to-tr from-primary/30 to-secondary/30 blur-3xl"
                        >
                        </div>

                        {/* Image Container */}
                        <div
                            class="border-glass-border/10 absolute inset-0 -rotate-3 transform overflow-hidden rounded-[2rem] border bg-white/40 shadow-2xl ring-1 ring-white/20 backdrop-blur-sm transition-all duration-500 hover:rotate-0 hover:border-primary/50 hover:shadow-primary-glow-hover dark:border-white/10 dark:bg-black/40"
                        >
                            <Image
                                src={profileImage}
                                alt="Tommaso Scalici"
                                widths={[192, 256, 320, 384, 576, 768, 1152]}
                                sizes="(max-width: 768px) 192px, (max-width: 1024px) 256px, (max-width: 1280px) 320px, 384px"
                                quality="mid"
                                format="webp"
                                loading="eager"
                                fetchpriority="high"
                                transition:name="profile-image"
                                class="h-full w-full transform object-cover opacity-90 transition-opacity duration-500 hover:scale-105 hover:opacity-100"
                            />
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    {/* Scroll Indicator */}
    <div class="mt-16 flex shrink-0 justify-center pb-24">
        <a
            href="#projects"
            aria-label="Scroll to projects"
            class="absolute bottom-8 left-1/2 -translate-x-1/2"
        >
            <svg
                xmlns="http://www.w3.org/2000/svg"
                fill="none"
                viewBox="0 0 24 24"
                stroke-width="1.5"
                stroke="currentColor"
                class="h-10 w-10 animate-bounce text-main transition-colors duration-300 hover:text-primary"
            >
                <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 8.25l-7.5 7.5-7.5-7.5"
                ></path>
            </svg>
        </a>
    </div>
</section>
