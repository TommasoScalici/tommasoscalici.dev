---
import { PlaylistCard } from '../PlaylistCard';
import { getEntry } from 'astro:content';
import { ui, defaultLang } from '../../i18n/ui';
import { getImage } from 'astro:assets';

interface Props {
    lang: string;
}

const { lang } = Astro.props;
const t = lang in ui ? ui[lang as keyof typeof ui] : ui[defaultLang];

const playlistEntry = await getEntry('playlists', lang);

if (!playlistEntry) {
    throw new Error(`Playlist entry for locale ${lang} not found.`);
}

// Optimize Playlist Images
const optimizedPlaylists = await Promise.all(
    playlistEntry.data.map(async (playlist) => {
        const webpImage = await getImage({
            src: playlist.coverImage,
            format: 'webp',
            width: 320,
            height: 180,
        });
        const avifImage = await getImage({
            src: playlist.coverImage,
            format: 'avif',
            width: 320,
            height: 180,
        });
        return {
            ...playlist,
            coverImage: webpImage.src,
            coverImageSet: {
                webp: webpImage.src,
                avif: avifImage.src,
            },
        };
    }),
);
---

<section id="playlists" class="bg-white/50 px-6 py-32 dark:bg-transparent">
    <div class="mx-auto max-w-7xl">
        <div class="mb-16 flex items-end justify-between">
            <div>
                <h2 class="mb-4 font-mono text-4xl font-bold md:text-5xl">
                    <span class="text-secondary">03.</span>
                    {t['section.playlists.title']}
                </h2>
                <p class="text-muted">{t['section.playlists']}</p>
            </div>
        </div>

        <div class="grid grid-cols-1 gap-6 md:grid-cols-2 lg:grid-cols-3">
            {
                optimizedPlaylists.map((playlist) => (
                    <PlaylistCard client:visible playlist={playlist} t={t} />
                ))
            }
        </div>
    </div>
</section>
