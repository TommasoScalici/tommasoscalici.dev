---
import { SEO } from 'astro-seo';

import { getCombinedSchema } from '../../data/json-ld';

interface Props {
    title: string;
    description: string;
    image?: string;
}

const { title, description, image = '/og-image.webp' } = Astro.props;

import { getLocalizedUrl, normalizePath } from '../../lib/seo';

// 1. Canonical & Hreflang Logic
const canonicalURL = new URL(normalizePath(Astro.url.pathname), Astro.site);
const path = Astro.url.pathname;

const site = Astro.site ?? Astro.url.origin;
const enUrl = getLocalizedUrl(path, site, 'en');
const itUrl = getLocalizedUrl(path, site, 'it');

import { getImage } from 'astro:assets';

import profileImage from '../../assets/profile.webp';

const optimizedProfile = await getImage({
    src: profileImage,
    format: 'webp',
    width: 800,
});
const siteUrl = site.toString();
const profileUrl = new URL(optimizedProfile.src, siteUrl).toString();
const ogImageUrl = new URL(image, siteUrl).toString();

// 2. The Identity Graph Data
const combinedSchema = getCombinedSchema(canonicalURL, profileUrl);
---

<script is:inline type="application/ld+json" set:html={JSON.stringify(combinedSchema)} />

<SEO
    title={title}
    description={description}
    canonical={canonicalURL.toString()}
    openGraph={{
        basic: {
            title,
            type: 'website',
            image: ogImageUrl,
        },
        image: {
            alt: title,
            width: 1200,
            height: 630,
        },
        optional: { locale: Astro.currentLocale === 'it' ? 'it_IT' : 'en_US' },
    }}
    twitter={{
        creator: '@Tommaso_Scalici',
        card: 'summary_large_image',
        image: ogImageUrl,
    }}
    extend={{
        link: [
            { rel: 'icon', href: '/favicon.ico', sizes: 'any' },
            { rel: 'icon', href: '/apple-touch-icon.png', type: 'image/png', sizes: '180x180' },
            { rel: 'apple-touch-icon', href: '/apple-touch-icon.png' },
            // Hreflangs
            { rel: 'alternate', hreflang: 'en', href: enUrl },
            { rel: 'alternate', hreflang: 'it', href: itUrl },
            { rel: 'alternate', hreflang: 'x-default', href: enUrl },
        ],
        meta: [
            {
                name: 'viewport',
                content: 'width=device-width, initial-scale=1',
            },
            { name: 'generator', content: Astro.generator },
        ],
    }}
/>
