---
interface Props {
    gaId?: string;
    fbPixelId?: string;
    tiktokPixelId?: string;
    enableFbPixel?: boolean;
    enableTiktokPixel?: boolean;
    autoConsent?: boolean;
}

import analyticsScript from '../../scripts/analytics.js?raw';

const {
    gaId,
    fbPixelId,
    tiktokPixelId,
    enableFbPixel = false,
    enableTiktokPixel = false,
    autoConsent = false,
} = Astro.props;
const hasAnalytics = [gaId, enableFbPixel && fbPixelId, enableTiktokPixel && tiktokPixelId].some(
    (id) => !!id,
);
---

<!-- Analytics Configuration -->
{hasAnalytics && (
    <>
        <script
            is:inline
            set:html={`
                window.ANALYTICS_CONFIG = {
                    gaId: ${JSON.stringify(gaId)},
                    fbPixelId: ${JSON.stringify(enableFbPixel ? fbPixelId : undefined)},
                    tiktokPixelId: ${JSON.stringify(enableTiktokPixel ? tiktokPixelId : undefined)},
                    autoConsent: ${Boolean(autoConsent)},
                };
            `}
        ></script>
        <script is:inline set:html={analyticsScript}></script>
    </>
)}
