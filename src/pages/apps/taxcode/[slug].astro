---
import { type CollectionEntry, getCollection } from 'astro:content';

import LegalLayout from '../../../layouts/LegalLayout.astro';

export async function getStaticPaths() {
    // Fetch all legal docs
    const allLegal = await getCollection('legal');
    // Filter for English docs related to 'taxcode' (exclude .it.md files)
    const taxCodeDocs = allLegal.filter(
        (doc: CollectionEntry<'legal'>) =>
            doc.id.startsWith('taxcode/') && !doc.id.endsWith('.it.md'),
    );

    return taxCodeDocs.map((doc: CollectionEntry<'legal'>) => {
        // Extract slug from filename (e.g., 'taxcode/data-deletion.md' -> 'data-deletion')
        const slug = doc.id.split('/').pop()?.replace('.md', '') ?? '';
        return {
            params: { slug },
            props: { doc },
        };
    });
}

interface Props {
    doc: CollectionEntry<'legal'>;
}

const { doc } = Astro.props;
const { Content } = await doc.render();
---

<LegalLayout title={doc.data.title} description={doc.data.description} lang="en">
    <Content />
</LegalLayout>
