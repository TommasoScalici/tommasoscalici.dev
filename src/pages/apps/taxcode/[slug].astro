---
import { type CollectionEntry, getCollection, render } from 'astro:content';

import LegalLayout from '../../../layouts/LegalLayout.astro';

export async function getStaticPaths() {
    // Fetch all legal docs
    const allLegal = await getCollection('legal');
    // Filter for English docs related to 'taxcode' (exclude those ending in 'it')
    const taxCodeDocs = allLegal.filter(
        (doc: CollectionEntry<'legal'>) => doc.id.startsWith('taxcode/') && !doc.id.endsWith('it'),
    );

    return taxCodeDocs.map((doc: CollectionEntry<'legal'>) => {
        // Extract slug from ID (e.g., 'taxcode/data-deletion' -> 'data-deletion')
        const slug = doc.id.split('/').pop() ?? '';
        return {
            params: { slug },
            props: { doc },
        };
    });
}

interface Props {
    doc: CollectionEntry<'legal'>;
}

const { doc } = Astro.props;
const { Content } = await render(doc);
---

<LegalLayout title={doc.data.title} description={doc.data.description} lang="en">
    <Content />
</LegalLayout>
