---
import SpotifyDeepLinkButton from '../components/common/SpotifyDeepLinkButton.astro';
import SpotifyLandingLayout from '../layouts/SpotifyLandingLayout.astro';
import { getPlaylistCover } from '../lib/spotify';

const title = 'Coding Lofi | Focus Music for Devs';
const description = 'Focus music designed for Developers. Python, JS, C++ & Deep Work.';
const playlistId = '0yF9pJ62XkAgxDGMlbyenf';

// Fetch thumbnail at build time with cache and guaranteed fallback
const coverImage = await getPlaylistCover(playlistId);
---

<SpotifyLandingLayout title={title} description={description} coverImage={coverImage} theme="lofi">
    <h1 class="mb-2 text-[22px] font-bold tracking-tight">Coding Lofi ☕</h1>
    <p class="text-zinc-400 mb-7 text-sm leading-normal">
        Focus music curated for Developers.
        <br />
        <span class="text-sky-400 font-semibold">Python</span>,{' '}
        <span class="text-sky-400 font-semibold">JS</span>,{' '}
        <span class="text-sky-400 font-semibold">C++</span> &{' '}
        <span class="text-sky-400 font-semibold">Deep Work</span>.
    </p>

    <SpotifyDeepLinkButton playlistId={playlistId} eventName="Coding Lofi" />
</SpotifyLandingLayout>
