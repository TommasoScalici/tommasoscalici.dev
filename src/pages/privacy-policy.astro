---
import { getEntry } from 'astro:content';

import LegalLayout from '../layouts/LegalLayout.astro';

const entry =
    (await getEntry('legal', 'privacy-policy')) || (await getEntry('legal', 'privacy-policy.md'));

if (!entry) {
    return Astro.redirect('/');
}

const { Content } = await entry.render();
---

<LegalLayout title={entry.data.title} description={entry.data.description} lang="en">
    <Content />
</LegalLayout>
