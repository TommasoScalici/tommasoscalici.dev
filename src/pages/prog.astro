---
import SpotifyDeepLinkButton from '../components/common/SpotifyDeepLinkButton.astro';
import SpotifyLandingLayout from '../layouts/SpotifyLandingLayout.astro';
import { getPlaylistCover } from '../lib/spotify';

const title = 'Modern Prog | Instrumental Metal';
const description =
    'The best Modern Instrumental Progressive Metal. Djent, Math Rock & Heavy Riffs.';
const playlistId = '32xYNI24QWMWfSgG1xZgjI';

// Fetch thumbnail at build time with cache and guaranteed fallback
const coverImage = await getPlaylistCover(playlistId);
---

<SpotifyLandingLayout title={title} description={description} coverImage={coverImage} theme="prog">
    <style>
        /* Typography */
        h1 {
            font-size: 24px;
            font-weight: 800;
            margin-bottom: 8px;
            text-transform: uppercase;
            letter-spacing: 1px;
        }
        .subtitle {
            color: var(--color-muted);
            font-size: 14px;
            margin-bottom: 30px;
            line-height: 1.5;
        }

        /* Highlight Cyberpunk */
        .highlight {
            color: var(--color-primary);
            font-weight: 700;
            text-shadow: var(--shadow-primary-glow);
        }
    </style>

    <h1>Modern Prog ⚡</h1>
    <p class="subtitle">
        The ultimate Progressive Instrumental collection.
        <br />
        <span class="highlight">Djent</span>, <span class="highlight">Math Rock</span> &{' '}
        <span class="highlight">Heavy Riffs</span>.
    </p>

    <SpotifyDeepLinkButton playlistId={playlistId} eventName="Modern Prog" />
</SpotifyLandingLayout>
