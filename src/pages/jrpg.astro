---
import SpotifyDeepLinkButton from '../components/common/SpotifyDeepLinkButton.astro';
import SpotifyLandingLayout from '../layouts/SpotifyLandingLayout.astro';
import { getPlaylistCover } from '../lib/spotify';

const title = 'Anime & JRPG Boss Battles | Epic Soundtracks & Battle Themes';
const description =
    'Epic symphonic, orchestral, and heavy battle themes from anime, JRPGs, and game soundtracks.';
const playlistId = '0B9L4giAynskXuohTu4MgI';

// Fetch thumbnail at build time with cache and guaranteed fallback
const coverImage = await getPlaylistCover(playlistId);
---

<SpotifyLandingLayout title={title} description={description} coverImage={coverImage} theme="jrpg">
    <h1 class="mb-2 text-[23px] font-extrabold uppercase tracking-tight">
        Anime & JRPG Boss Battles ⚔️
    </h1>
    <p class="text-zinc-400 mb-7 text-sm leading-normal">
        Epic battle themes, orchestrations & heavy riffs.
        <br />
        <span class="text-rose-400 font-bold drop-shadow-[0_0_12px_rgba(251,113,133,0.45)]">
            Final Fantasy
        </span>
        ,{' '}
        <span class="text-purple-400 font-bold drop-shadow-[0_0_12px_rgba(192,132,252,0.45)]">
            Persona
        </span>
        ,{' '}
        <span class="text-amber-400 font-bold drop-shadow-[0_0_12px_rgba(251,191,36,0.45)]">
            Evangelion
        </span>
        ,{' '}
        <span class="text-rose-400 font-bold drop-shadow-[0_0_12px_rgba(251,113,133,0.45)]">
            Death Note
        </span>{' '}
        &{' '}
        <span class="text-purple-400 font-bold drop-shadow-[0_0_12px_rgba(192,132,252,0.45)]">
            Attack on Titan
        </span>
        .
    </p>

    <SpotifyDeepLinkButton playlistId={playlistId} eventName="Anime & JRPG Boss Battles" />
</SpotifyLandingLayout>
