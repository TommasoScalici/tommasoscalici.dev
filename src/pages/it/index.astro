---
import Layout from "../../layouts/Layout.astro";
import HeroSection from "../../components/sections/HeroSection.astro";
import ProjectsSection from "../../components/sections/ProjectsSection.astro";
import MusicSection from "../../components/sections/MusicSection.astro";
import PlaylistsSection from "../../components/sections/PlaylistsSection.astro";
import { bioData } from "../../data/bio";

const lang = "it";
const bio = bioData[lang];
---

<Layout
    title="Tommaso Scalici | Software Engineer & Musicista"
    description={bio.description}
    lang={lang}
>
    <HeroSection lang={lang} />
    <ProjectsSection lang={lang} />

    <!-- Narrative Bio Section -->
    <section
        class="relative bg-white/5 border-t border-white/10 overflow-hidden"
    >
        <div class="max-w-7xl mx-auto px-6 py-24">
            <div class="grid md:grid-cols-2 gap-12 items-center">
                {/* Left Column: The Hook */}
                <div class="border-l-4 border-cyan-500 pl-6">
                    <h2
                        class="text-3xl md:text-5xl font-mono font-bold leading-tight bg-gradient-to-r from-cyan-400 to-purple-600 bg-clip-text text-transparent"
                    >
                        {bio.title}
                    </h2>
                </div>

                {/* Right Column: The Narrative */}
                <div
                    class="space-y-6 text-lg text-gray-300 font-sans leading-relaxed"
                >
                    <p
                        set:html={bio.paragraph1.replace(
                            /(RPG Maker XP|Nobuo Uematsu)/g,
                            '<span class="text-white font-semibold">$1</span>',
                        )}
                    />
                    <p
                        set:html={bio.paragraph2.replace(
                            /(.NET|Dream Theater)/g,
                            '<span class="text-white font-semibold">$1</span>',
                        )}
                    />
                </div>
            </div>
        </div>

        {/* Subtle Background Radial */}
        <div
            class="absolute inset-0 pointer-events-none bg-[radial-gradient(circle_at_top_right,_var(--tw-gradient-stops))] from-cyan-900/10 to-transparent opacity-50"
        >
        </div>
    </section>

    <MusicSection lang={lang} />
    <PlaylistsSection lang={lang} />
</Layout>
