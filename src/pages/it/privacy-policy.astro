---
import { getCollection } from 'astro:content';

import LegalLayout from '../../layouts/LegalLayout.astro';

const entries = await getCollection('legal');
const entry = entries.find((e) => e.id.startsWith('privacy-policy.it'));

if (!entry) {
    return Astro.redirect('/it/');
}

const { Content } = await entry.render();
---

<LegalLayout title={entry.data.title} description={entry.data.description} lang="it">
    <Content />
</LegalLayout>
