---
import { type CollectionEntry, getCollection, render } from 'astro:content';

import LegalLayout from '../../../../layouts/LegalLayout.astro';

export async function getStaticPaths() {
    // Fetch all legal docs
    const allLegal = await getCollection('legal');
    // Filter for Italian docs related to 'taxcode' (IDs ending in 'it')
    const taxCodeDocs = allLegal.filter(
        (doc) => doc.id.startsWith('taxcode/') && doc.id.endsWith('it'),
    );

    return taxCodeDocs.map((doc) => {
        // Extract slug from ID (e.g., 'taxcode/data-deletionit' -> 'data-deletion')
        const slug = doc.id.split('/').pop()?.replace('it', '') ?? '';
        return {
            params: { slug },
            props: { doc },
        };
    });
}

interface Props {
    doc: CollectionEntry<'legal'>;
}

const { doc } = Astro.props;
const { Content } = await render(doc);
---

<LegalLayout title={doc.data.title} description={doc.data.description} lang="it">
    <Content />
</LegalLayout>
