---
import { getCollection, type CollectionEntry } from 'astro:content';
import LegalLayout from '../../../../layouts/LegalLayout.astro';

export async function getStaticPaths() {
    // Fetch all legal docs
    const allLegal = await getCollection('legal');
    // Filter for Italian docs related to 'taxcode' (end with .it.md)
    const taxCodeDocs = allLegal.filter(
        (doc) => doc.id.startsWith('taxcode/') && doc.id.endsWith('.it.md'),
    );

    return taxCodeDocs.map((doc) => {
        // Extract slug from filename (e.g., 'taxcode/data-deletion.it.md' -> 'data-deletion')
        const slug = doc.id.split('/').pop()?.replace('.it.md', '') ?? '';
        return {
            params: { slug },
            props: { doc },
        };
    });
}

interface Props {
    doc: CollectionEntry<'legal'>;
}

const { doc } = Astro.props;
const { Content } = await doc.render();
---

<LegalLayout title={doc.data.title} description={doc.data.description} lang="it">
    <Content />
</LegalLayout>
