---
import '@fontsource/inter';
import '@fontsource/jetbrains-mono';
import '../styles/global.css';

import { getImage } from 'astro:assets';
import { ClientRouter } from 'astro:transitions';

import logoImage from '../assets/logo.webp';
import Analytics from '../components/Analytics.astro';
import { Footer } from '../components/Footer';
import { Header } from '../components/Header';
import SEOHead from '../components/SEOHead.astro';
import { defaultLang, ui } from '../i18n/ui';

const optimizedLogo = await getImage({
    src: logoImage,
    width: 64, // Slightly larger for high DPR
    height: 64,
    format: 'webp',
});

interface Props {
    title: string;
    description?: string;
    lang?: string;
}

const {
    title,
    description = 'Senior Software Engineer & Prog Metal Musician',
    lang = defaultLang,
} = Astro.props;

const t = lang in ui ? ui[lang as keyof typeof ui] : ui[defaultLang];

import { getRelativeLocaleUrl } from 'astro:i18n';

const navItems = [
    { label: t['nav.home'], href: getRelativeLocaleUrl(lang, '/') },
    { label: t['nav.projects'], href: '#projects' },
    { label: t['nav.music'], href: '#music' },
    { label: t['nav.playlists'], href: '#playlists' },
];

const targetLang = lang === 'en' ? 'it' : 'en';
const targetLangUrl = getRelativeLocaleUrl(
    targetLang,
    Astro.url.pathname.replace(/^\/it\//, '/') || '/',
);
const currentYear = new Date().getFullYear();
const startYear = 2010; // Career start
const copyrightDate =
    startYear === currentYear
        ? startYear.toString()
        : `${startYear.toString()} - ${currentYear.toString()}`;
---

<!doctype html>
<html lang={lang} class="scroll-smooth">
    <head>
        <meta charset="UTF-8" />
        <script is:inline>
            // Prevent FOUC
            function getTheme() {
                if (typeof localStorage !== 'undefined' && localStorage.getItem('theme')) {
                    return localStorage.getItem('theme');
                }
                return 'dark';
            }

            function applyTheme() {
                const theme = getTheme();
                if (theme === 'light') {
                    document.documentElement.setAttribute('data-theme', 'light');
                    document.documentElement.classList.remove('dark');
                } else {
                    document.documentElement.removeAttribute('data-theme');
                    document.documentElement.classList.add('dark');
                }
            }

            applyTheme();
            document.addEventListener('astro:after-swap', applyTheme);

            // Language Persistence
            function checkLanguage() {
                if (typeof localStorage === 'undefined' || typeof window === 'undefined') return;

                const storedLang = localStorage.getItem('lang');
                const currentPath = window.location.pathname;

                // If no stored lang or stored lang matches current path prefix/root, do nothing
                if (!storedLang) return;

                const worksInEnglish = !currentPath.startsWith('/it');
                const worksInItalian = currentPath.startsWith('/it');

                // If we are in English but user prefers Italian
                if (worksInEnglish && storedLang === 'it') {
                    if (currentPath === '/') {
                        window.location.replace('/it');
                    }
                }

                // If we are in Italian but user prefers English
                if (worksInItalian && storedLang === 'en') {
                    if (currentPath === '/it' || currentPath === '/it/') {
                        window.location.replace('/');
                    }
                }
            }

            checkLanguage();
        </script>
        <Analytics id="G-LMT1M9750Q" />
        <SEOHead title={title} description={description} />
        <ClientRouter />
    </head>

    <body
        class="bg-background font-sans text-main antialiased selection:bg-primary selection:text-inverse"
    >
        <a
            href="#main-content"
            class="sr-only focus:not-sr-only focus:absolute focus:z-50 focus:bg-background focus:p-4 focus:text-primary focus:outline-none"
        >
            {t['nav.skipToContent']}
        </a>
        <Header
            client:idle
            lang={lang}
            navItems={navItems}
            logoSrc={optimizedLogo.src}
            targetLangUrl={targetLangUrl}
        />

        <main id="main-content" class="relative min-h-screen overflow-hidden pt-20">
            <div
                class="pointer-events-none fixed left-1/4 top-0 -z-10 h-96 w-96 rounded-full bg-primary/10 blur-[128px]"
            >
            </div>
            <div
                class="pointer-events-none fixed bottom-0 right-1/4 -z-10 h-96 w-96 rounded-full bg-secondary/10 blur-[128px]"
            >
            </div>

            <slot />
        </main>

        <Footer client:visible lang={lang} t={t} copyrightDate={copyrightDate} />
    </body>
</html>
