---
import '@fontsource-variable/inter';
import '@fontsource-variable/jetbrains-mono';
import '../styles/global.css';

import { ClientRouter } from 'astro:transitions';

import logoImage from '../assets/logo.webp';
import AnalyticsHead from '../components/head/AnalyticsHead.astro';
import SEOHead from '../components/head/SEOHead.astro';
import CookieBanner from '../components/layout/CookieBanner.astro';
import Footer from '../components/layout/Footer.astro';
import Header from '../components/layout/Header.astro';
import { defaultLang, ui } from '../i18n/ui';

interface Props {
    title: string;
    description?: string;
    lang?: string;
}

const {
    title,
    description = 'Senior Software Engineer & Prog Metal Musician',
    lang = defaultLang,
} = Astro.props;

const t = lang in ui ? ui[lang as keyof typeof ui] : ui[defaultLang];

const currentPath = Astro.url.pathname;
const isHome = currentPath === '/' || currentPath === '/it/' || currentPath === '/it'; // Handle trailing slash variations

const homeLink = lang === 'en' ? '/' : '/it/';

const navItems = [
    { label: t['nav.home'], href: homeLink },
    { label: t['nav.projects'], href: isHome ? '#projects' : `${homeLink}#projects` },
    { label: t['nav.music'], href: isHome ? '#music' : `${homeLink}#music` },
    { label: t['nav.playlists'], href: isHome ? '#playlists' : `${homeLink}#playlists` },
];

const targetLang = lang === 'en' ? 'it' : 'en';
// Generate a relative path for the language switcher (not absolute URL)
import { normalizePath } from '../lib/seo';
const cleanPath = normalizePath(Astro.url.pathname, true);
const targetLangUrl = targetLang === 'it' ? `/it${cleanPath}` : cleanPath;
const currentYear = new Date().getFullYear();
const startYear = 2010; // Career start
const copyrightDate =
    startYear === currentYear
        ? startYear.toString()
        : `${startYear.toString()} - ${currentYear.toString()}`;
---

<!doctype html>
<html lang={lang} class="scroll-smooth">
    <head>
        <meta charset="UTF-8" />
        <script is:inline>
            // Prevent FOUC
            function getTheme() {
                if (typeof localStorage !== 'undefined' && localStorage.getItem('theme')) {
                    return localStorage.getItem('theme');
                }
                return 'dark';
            }

            function applyTheme() {
                const theme = getTheme();
                if (theme === 'light') {
                    document.documentElement.setAttribute('data-theme', 'light');
                    document.documentElement.classList.remove('dark');
                } else {
                    document.documentElement.removeAttribute('data-theme');
                    document.documentElement.classList.add('dark');
                }
            }

            applyTheme();
            document.addEventListener('astro:after-swap', applyTheme);

            // Maintain scroll and hash after language switches for an "in-place translation" effect
            if ('history' in window && 'scrollRestoration' in history) {
                history.scrollRestoration = 'manual';
            }

            document.addEventListener('astro:after-swap', () => {
                const envScroll = sessionStorage.getItem('lang-switch-scroll');
                const envHash = sessionStorage.getItem('lang-switch-hash');

                if (envScroll !== null) {
                    // Temporarily disable smooth scrolling to instantly snap to the saved position
                    document.documentElement.classList.remove('scroll-smooth');
                    window.scrollTo(0, parseInt(envScroll));
                    // Force a reflow or wait for the next frame to re-enable
                    requestAnimationFrame(() => {
                        document.documentElement.classList.add('scroll-smooth');
                    });
                    sessionStorage.removeItem('lang-switch-scroll');
                }

                if (envHash) {
                    history.replaceState(null, '', window.location.pathname + envHash);
                    sessionStorage.removeItem('lang-switch-hash');
                }
            });

            // Language Persistence
            function checkLanguage() {
                if (typeof localStorage === 'undefined' || typeof window === 'undefined') return;

                const storedLang = localStorage.getItem('lang');
                const currentPath = window.location.pathname;

                // If no stored lang or stored lang matches current path prefix/root, do nothing
                if (!storedLang) return;

                const worksInEnglish = !currentPath.startsWith('/it');
                const worksInItalian = currentPath.startsWith('/it');

                // If we are in English but user prefers Italian
                if (worksInEnglish && storedLang === 'it') {
                    if (currentPath === '/') {
                        window.location.replace('/it/');
                    }
                }

                // If we are in Italian but user prefers English
                if (worksInItalian && storedLang === 'en') {
                    if (currentPath === '/it' || currentPath === '/it/') {
                        window.location.replace('/');
                    }
                }
            }

            checkLanguage();
        </script>
        <AnalyticsHead gaId="G-LMT1M9750Q" />
        <!-- Preconnect to analytics domains -->
        <link rel="preconnect" href="https://www.googletagmanager.com" crossorigin />
        <link rel="dns-prefetch" href="https://connect.facebook.net" />
        <link rel="dns-prefetch" href="https://analytics.tiktok.com" />
        <SEOHead title={title} description={description} />
        <ClientRouter />
    </head>

    <body
        class="bg-background text-main selection:bg-primary selection:text-inverse font-sans antialiased"
    >
        <CookieBanner lang={lang} />
        <script is:inline>
            (function initConsentController() {
                function updateConsent(isUpdate) {
                    var consent = localStorage.getItem('user-consent') || 'pending';
                    var grantedStatus = consent === 'granted' ? 'granted' : 'denied';
                    var gtagPayload = {
                        ad_storage: grantedStatus,
                        ad_user_data: grantedStatus,
                        ad_personalization: grantedStatus,
                        analytics_storage: grantedStatus,
                    };

                    if (consent === 'granted') {
                        if (typeof window.gtag === 'function') {
                            window.gtag('consent', 'update', gtagPayload);
                            if (window.ANALYTICS_CONFIG && window.ANALYTICS_CONFIG.gaId) {
                                var gaId = window.ANALYTICS_CONFIG.gaId;
                                if (
                                    !document.querySelector(
                                        'script[src*="/metrics/gtag/js?id=' + gaId + '"]',
                                    )
                                ) {
                                    var s = document.createElement('script');
                                    s.type = 'text/javascript';
                                    s.async = true;
                                    s.crossOrigin = 'anonymous';
                                    s.src = 'https://www.googletagmanager.com/gtag/js?id=' + gaId;
                                    var f = document.getElementsByTagName('script')[0];
                                    f.parentNode.insertBefore(s, f);
                                }
                            }
                            if (isUpdate) window.gtag('event', 'page_view');
                        }
                        if (typeof window.fbq === 'function') {
                            window.fbq('consent', 'grant');
                            if (window.ANALYTICS_CONFIG && window.ANALYTICS_CONFIG.fbPixelId) {
                                window.fbq(
                                    'set',
                                    'autoConfig',
                                    false,
                                    window.ANALYTICS_CONFIG.fbPixelId,
                                );
                            }
                            if (isUpdate) window.fbq('track', 'PageView');
                        }
                        if (window.ttq) {
                            window.ttq.enableCookie();
                            if (
                                isUpdate &&
                                window.ANALYTICS_CONFIG &&
                                window.ANALYTICS_CONFIG.tiktokPixelId
                            ) {
                                var pId = window.ANALYTICS_CONFIG.tiktokPixelId;
                                if (!window.ttq._i || !window.ttq._i[pId]) {
                                    window.ttq.load(pId, {
                                        auto_collect: false,
                                    });
                                }
                                window.ttq.page();
                            }
                        }
                    } else {
                        if (typeof window.gtag === 'function')
                            window.gtag('consent', 'update', gtagPayload);
                        if (typeof window.fbq === 'function') window.fbq('consent', 'revoke');
                        if (window.ttq) window.ttq.disableCookie();
                    }
                }
                updateConsent(false);
                window.addEventListener('consent-update', function () {
                    updateConsent(true);
                });
            })();
        </script>
        <a
            href="#main-content"
            class="focus:bg-background focus:text-primary sr-only focus:not-sr-only focus:absolute focus:z-50 focus:p-4 focus:outline-none"
        >
            {t['nav.skipToContent']}
        </a>
        <Header lang={lang} navItems={navItems} logoSrc={logoImage} targetLangUrl={targetLangUrl} />

        <main id="main-content" class="relative min-h-screen overflow-hidden pt-20">
            <div
                class="bg-primary/10 pointer-events-none fixed top-0 left-1/4 -z-10 h-96 w-96 rounded-full blur-[128px]"
            >
            </div>
            <div
                class="bg-secondary/10 pointer-events-none fixed right-1/4 bottom-0 -z-10 h-96 w-96 rounded-full blur-[128px]"
            >
            </div>

            <slot />
        </main>

        <Footer lang={lang} t={t} copyrightDate={copyrightDate} />
    </body>
</html>
