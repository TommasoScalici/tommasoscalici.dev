---
import '@fontsource/inter/400.css';
import '@fontsource/inter/500.css';
import '@fontsource/inter/600.css';
import '@fontsource/inter/700.css';
import '@fontsource/jetbrains-mono/400.css';
import '@fontsource/jetbrains-mono/500.css';
import '@fontsource/jetbrains-mono/600.css';
import '@fontsource/jetbrains-mono/700.css';
import '../styles/global.css';

import type { ImageMetadata } from 'astro';
import { getImage, Image } from 'astro:assets';

import AnalyticsHead from '../components/AnalyticsHead.astro';
import { ConsentController } from '../components/ConsentController';
import { CookieBanner } from '../components/CookieBanner';

interface Props {
    title: string;
    description: string;
    coverImage: ImageMetadata;
    theme: 'lofi' | 'prog';
}

const { title, description, coverImage, theme } = Astro.props;

// Optimize image for background and SEO
const optimizedBg = await getImage({ src: coverImage, format: 'webp' });

// Theme Configuration
const themeConfig = {
    prog: {
        bgBlur: 'filter: blur(30px) brightness(0.3);',
        card: 'background: rgba(10, 10, 10, 0.8); backdrop-filter: blur(15px); border: 1px solid rgba(0, 243, 255, 0.2); box-shadow: 0 0 40px rgba(0, 243, 255, 0.1);',
        coverShadow: 'box-shadow: 0 10px 30px rgba(0,0,0,0.6);',
    },
    lofi: {
        bgBlur: 'filter: blur(25px) brightness(0.4);',
        card: 'background: rgba(22, 27, 34, 0.85); backdrop-filter: blur(10px); border: 1px solid rgba(255, 255, 255, 0.1); box-shadow: 0 20px 50px rgba(0,0,0,0.5);',
        coverShadow: 'box-shadow: 0 8px 20px rgba(0,0,0,0.4);',
    },
};

const currentTheme = themeConfig[theme];
const gradientClasses =
    theme === 'lofi'
        ? 'from-indigo-500 via-sky-500 to-indigo-500'
        : 'from-[#00f3ff] via-[#ff0055] to-[#00f3ff]';
---

<!doctype html>
<html lang="en" class="dark">
    <head>
        <meta charset="UTF-8" />
        <meta
            name="viewport"
            content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no"
        />
        <title>{title}</title>

        <meta name="description" content={description} />
        <meta property="og:title" content={title} />
        <meta property="og:description" content={description} />
        <meta property="og:image" content={optimizedBg.src} />
        <meta property="og:type" content="music.playlist" />

        <AnalyticsHead
            gaId="G-LMT1M9750Q"
            fbPixelId={import.meta.env.PUBLIC_FACEBOOK_PIXEL_ID}
            tiktokPixelId={import.meta.env.PUBLIC_TIKTOK_PIXEL_ID}
        />

        <style>
            @keyframes floatUp {
                from {
                    opacity: 0;
                    transform: translateY(30px);
                }
                to {
                    opacity: 1;
                    transform: translateY(0);
                }
            }
        </style>
    </head>
    <body
        class="relative flex h-screen items-center justify-center overflow-hidden font-sans text-white"
        style={theme === 'lofi' ? 'background-color: #0d1117;' : 'background-color: #050505;'}
    >
        <ConsentController client:load />
        <CookieBanner client:load lang="en" />
        <div
            class="absolute left-0 top-0 -z-10 h-full w-full scale-110 bg-cover bg-center bg-no-repeat"
            style={`${currentTheme.bgBlur} background-image: url('${optimizedBg.src}');`}
        >
        </div>

        <div
            class="w-[90%] max-w-[380px] rounded-3xl p-[30px_20px] text-center"
            style={`${currentTheme.card} animation: floatUp 0.8s cubic-bezier(0.2, 0.8, 0.2, 1);`}
        >
            <div class="group relative mx-auto mb-5 aspect-square w-full rounded-xl">
                <div
                    class={`absolute -inset-1 animate-spin-slow rounded-xl bg-gradient-to-r opacity-75 blur-lg transition duration-1000 group-hover:duration-200 group-hover:opacity-100 ${gradientClasses}`}
                >
                </div>
                {
                    typeof coverImage === 'string' ? (
                        <Image
                            src={coverImage}
                            width={300}
                            height={300}
                            loading="eager"
                            class="relative h-full w-full rounded-xl object-cover"
                            style={currentTheme.coverShadow}
                            alt={`${title} Cover`}
                        />
                    ) : (
                        <Image
                            src={coverImage}
                            width={300}
                            height={300}
                            loading="eager"
                            class="relative h-full w-full rounded-xl object-cover"
                            style={currentTheme.coverShadow}
                            alt={`${title} Cover`}
                        />
                    )
                }
            </div>

            <slot />

            <div
                class={`mt-5 text-[11px] ${theme === 'lofi' ? 'text-[#484f58]' : 'text-[#666]'} border-none outline-none bg-transparent`}
            >
                Curated by <a
                    href="https://tommasoscalici.dev"
                    target="_blank"
                    class="border-b border-transparent bg-transparent font-semibold text-inherit no-underline outline-none transition-colors duration-200 hover:border-white hover:text-white"
                    >Tommaso Scalici</a
                >
            </div>
        </div>
    </body>
</html>
