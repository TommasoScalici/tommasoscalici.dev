---
import '@fontsource-variable/inter';
import '@fontsource-variable/jetbrains-mono';
import '../styles/global.css';

import type { ImageMetadata } from 'astro';
import { getImage, Image } from 'astro:assets';
import { PUBLIC_FACEBOOK_PIXEL_ID, PUBLIC_TIKTOK_PIXEL_ID } from 'astro:env/client';

import AnalyticsHead from '../components/head/AnalyticsHead.astro';
import CookieBanner from '../components/layout/CookieBanner.astro';
import { normalizePath } from '../lib/seo';

interface Props {
    title: string;
    description: string;
    coverImage: ImageMetadata;
    theme: 'lofi' | 'prog';
}

const { title, description, coverImage, theme } = Astro.props;

// Optimize image for background and SEO
const optimizedBg = await getImage({ src: coverImage, format: 'webp', width: 400 });

// Canonical URL
const canonicalURL = new URL(normalizePath(Astro.url.pathname), Astro.site);
const themeColor = theme === 'lofi' ? '#0d1117' : '#050505';

// Theme Configuration
const themeConfig = {
    prog: {
        bgBlur: 'filter: blur(30px) brightness(0.3);',
        card: 'background: rgba(10, 10, 10, 0.8); backdrop-filter: blur(15px); border: 1px solid rgba(0, 243, 255, 0.2); box-shadow: 0 0 40px rgba(0, 243, 255, 0.1);',
        coverShadow: 'box-shadow: 0 10px 30px rgba(0,0,0,0.6);',
    },
    lofi: {
        bgBlur: 'filter: blur(25px) brightness(0.4);',
        card: 'background: rgba(22, 27, 34, 0.85); backdrop-filter: blur(10px); border: 1px solid rgba(255, 255, 255, 0.1); box-shadow: 0 20px 50px rgba(0,0,0,0.5);',
        coverShadow: 'box-shadow: 0 8px 20px rgba(0,0,0,0.4);',
    },
};

const currentTheme = themeConfig[theme];
const gradientClasses =
    theme === 'lofi'
        ? 'from-indigo-500 via-sky-500 to-indigo-500'
        : 'from-[#00f3ff] via-[#ff0055] to-[#00f3ff]';
---

<!doctype html>
<html lang="en" class="dark">
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />
        <title>{title}</title>

        <!-- SEO -->
        <meta name="description" content={description} />
        <meta name="robots" content="noindex, nofollow" />
        <link rel="canonical" href={canonicalURL.toString()} />
        <meta name="theme-color" content={themeColor} />
        <link rel="icon" href="/favicon.ico" sizes="any" />
        <link rel="icon" href="/apple-touch-icon.png" type="image/png" sizes="180x180" />
        <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

        <!-- Open Graph -->
        <meta property="og:title" content={title} />
        <meta property="og:description" content={description} />
        <meta property="og:image" content={optimizedBg.src} />
        <meta property="og:type" content="music.playlist" />

        <!-- Preconnect to analytics domains -->
        <link rel="preconnect" href="https://www.googletagmanager.com" crossorigin />
        <link rel="dns-prefetch" href="https://connect.facebook.net" />
        <link rel="dns-prefetch" href="https://analytics.tiktok.com" />

        <AnalyticsHead
            gaId="G-LMT1M9750Q"
            fbPixelId={PUBLIC_FACEBOOK_PIXEL_ID}
            tiktokPixelId={PUBLIC_TIKTOK_PIXEL_ID}
        />

        <style>
            @keyframes floatUp {
                from {
                    opacity: 0;
                    transform: translateY(30px);
                }
                to {
                    opacity: 1;
                    transform: translateY(0);
                }
            }
        </style>
    </head>
    <body
        class="relative flex h-screen items-center justify-center overflow-hidden font-sans text-white"
        style={theme === 'lofi' ? 'background-color: #0d1117;' : 'background-color: #050505;'}
    >
        <CookieBanner lang="en" />
        <script is:inline>
            (function initConsentController() {
                function updateConsent(isUpdate) {
                    var consent = localStorage.getItem('user-consent') || 'pending';
                    var grantedStatus = consent === 'granted' ? 'granted' : 'denied';
                    var gtagPayload = {
                        ad_storage: grantedStatus,
                        ad_user_data: grantedStatus,
                        ad_personalization: grantedStatus,
                        analytics_storage: grantedStatus,
                    };

                    if (consent === 'granted') {
                        if (typeof window.gtag === 'function') {
                            window.gtag('consent', 'update', gtagPayload);
                            if (window.ANALYTICS_CONFIG && window.ANALYTICS_CONFIG.gaId) {
                                var gaId = window.ANALYTICS_CONFIG.gaId;
                                if (
                                    !document.querySelector(
                                        'script[src*="/metrics/gtag/js?id=' + gaId + '"]',
                                    )
                                ) {
                                    var s = document.createElement('script');
                                    s.type = 'text/javascript';
                                    s.async = true;
                                    s.src = '/metrics/gtag/js?id=' + gaId;
                                    var f = document.getElementsByTagName('script')[0];
                                    f.parentNode.insertBefore(s, f);
                                }
                            }
                            if (isUpdate) window.gtag('event', 'page_view');
                        }
                        if (typeof window.fbq === 'function') {
                            window.fbq('consent', 'grant');
                            if (window.ANALYTICS_CONFIG && window.ANALYTICS_CONFIG.fbPixelId) {
                                window.fbq(
                                    'set',
                                    'autoConfig',
                                    false,
                                    window.ANALYTICS_CONFIG.fbPixelId,
                                );
                            }
                            if (isUpdate) window.fbq('track', 'PageView');
                        }
                        if (window.ttq) {
                            window.ttq.enableCookie();
                            if (
                                isUpdate &&
                                window.ANALYTICS_CONFIG &&
                                window.ANALYTICS_CONFIG.tiktokPixelId
                            ) {
                                var pId = window.ANALYTICS_CONFIG.tiktokPixelId;
                                if (!window.ttq._i || !window.ttq._i[pId]) {
                                    window.ttq.load(pId, {
                                        auto_collect: false,
                                    });
                                }
                                window.ttq.page();
                            }
                        }
                    } else {
                        if (typeof window.gtag === 'function')
                            window.gtag('consent', 'update', gtagPayload);
                        if (typeof window.fbq === 'function') window.fbq('consent', 'revoke');
                        if (window.ttq) window.ttq.disableCookie();
                    }
                }
                updateConsent(false);
                window.addEventListener('consent-update', function () {
                    updateConsent(true);
                });
            })();
        </script>
        <div
            class="absolute top-0 left-0 -z-10 h-full w-full scale-110 bg-cover bg-center bg-no-repeat"
            style={`${currentTheme.bgBlur} background-image: url('${optimizedBg.src}');`}
        >
        </div>

        <div
            class="w-[90%] max-w-[380px] rounded-3xl p-[30px_20px] text-center"
            style={`${currentTheme.card} animation: floatUp 0.8s cubic-bezier(0.2, 0.8, 0.2, 1);`}
        >
            <div class="group relative mx-auto mb-5 aspect-square w-full rounded-xl">
                <div
                    class={`absolute -inset-1 animate-spin-slow rounded-xl bg-linear-to-r opacity-75 blur-lg ${gradientClasses}`}
                >
                </div>
                <Image
                    src={coverImage}
                    width={300}
                    height={300}
                    loading="eager"
                    fetchpriority="high"
                    class="relative h-full w-full rounded-xl object-cover"
                    style={currentTheme.coverShadow}
                    alt={`${title} Cover`}
                />
            </div>

            <slot />

            <div
                class={`mt-5 text-[11px] ${theme === 'lofi' ? 'text-[#484f58]' : 'text-[#666]'} border-none outline-none bg-transparent`}
            >
                Curated by <a
                    href="https://tommasoscalici.dev"
                    target="_blank"
                    rel="noopener noreferrer"
                    class="border-b border-transparent bg-transparent font-semibold text-inherit no-underline transition-colors duration-200 outline-none hover:border-white hover:text-white"
                    >Tommaso Scalici</a
                >
            </div>
        </div>
    </body>
</html>
