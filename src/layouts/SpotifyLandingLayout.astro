---
import { getImage, Picture } from 'astro:assets';

import fallbackCover from '../assets/playlist-fallback.webp';
import SpotifyConsentDialog from '../components/dialogs/SpotifyConsentDialog.astro';
import { defaultLang, ui } from '../i18n/ui';
import { normalizePath } from '../lib/seo';
import BaseLayout from './BaseLayout.astro';

interface Props {
    title: string;
    description: string;
    coverImage: string;
    theme: 'lofi' | 'prog' | 'jrpg';
    lang?: string;
}

const { title, description, coverImage, theme, lang = defaultLang } = Astro.props;
const t = lang in ui ? ui[lang as keyof typeof ui] : ui[defaultLang];

// Robust fallback: if remote coverImage is empty/broken, fallback to local optimized WebP
const effectiveCover = coverImage && coverImage.trim() !== '' ? coverImage : fallbackCover;

// 1. High-priority optimized cover for LCP preload & picture tag
const optimizedCover = await getImage({
    src: effectiveCover,
    format: 'avif',
    width: 300,
    height: 300,
});

// 2. Ultra-lightweight blurred background (64x64 WebP, ~400 bytes instead of ~30KB)
const optimizedBg = await getImage({
    src: effectiveCover,
    format: 'webp',
    width: 64,
    height: 64,
    quality: 25,
});

// 3. Crisp OpenGraph image for social crawlers (640x640)
const ogImage = await getImage({
    src: effectiveCover,
    format: 'webp',
    width: 640,
    height: 640,
});

// Canonical URL
const canonicalURL = new URL(normalizePath(Astro.url.pathname), Astro.site);
const themeColor = theme === 'lofi' ? '#0d1117' : theme === 'jrpg' ? '#0a0514' : '#050505';

const gradientClasses =
    theme === 'lofi'
        ? 'from-indigo-500 via-sky-500 to-indigo-500'
        : theme === 'jrpg'
          ? 'from-rose-500 via-purple-600 to-amber-400'
          : 'from-primary via-secondary to-primary';
---

<BaseLayout title={title} lang={lang} hideCookieBanner={true}>
    <Fragment slot="head">
        <!-- Preload LCP Cover Image -->
        <link
            rel="preload"
            as="image"
            href={optimizedCover.src}
            type="image/avif"
            fetchpriority="high"
        />

        <!-- SEO -->
        <meta name="description" content={description} />
        <meta name="robots" content="noindex, nofollow" />
        <link rel="canonical" href={canonicalURL.toString()} />
        <meta name="theme-color" content={themeColor} />
        <link rel="icon" href="/favicon.ico" sizes="any" />
        <link rel="icon" href="/apple-touch-icon.png" type="image/png" sizes="180x180" />
        <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

        <!-- Open Graph -->
        <meta property="og:title" content={title} />
        <meta property="og:description" content={description} />
        <meta property="og:image" content={ogImage.src} />
        <meta property="og:type" content="music.playlist" />
    </Fragment>

    <div
        class="bg-background relative flex h-screen items-center justify-center overflow-hidden font-sans text-white"
        data-landing-theme={theme}
    >
        <div
            class="landing-bg absolute top-0 left-0 -z-10 h-full w-full scale-110 bg-cover bg-center bg-no-repeat"
            style={`background-image: url('${optimizedBg.src}');`}
        ></div>

        <div class="landing-card w-[90%] max-w-95 rounded-3xl p-[30px_20px] text-center">
            <div class="group relative mx-auto mb-5 aspect-square w-full rounded-xl">
                <div
                    class={`absolute -inset-1 animate-spin-slow rounded-xl bg-linear-to-r opacity-75 blur-lg ${gradientClasses}`}
                ></div>
                {typeof effectiveCover === 'string' ? (
                    <Picture
                        src={effectiveCover}
                        alt={`${title} Cover`}
                        width={300}
                        height={300}
                        formats={['avif', 'webp']}
                        loading="eager"
                        fetchpriority="high"
                        class="landing-cover relative h-full w-full rounded-xl object-cover"
                        inferSize={true}
                    />
                ) : (
                    <Picture
                        src={effectiveCover}
                        alt={`${title} Cover`}
                        width={300}
                        height={300}
                        formats={['avif', 'webp']}
                        loading="eager"
                        fetchpriority="high"
                        class="landing-cover relative h-full w-full rounded-xl object-cover"
                    />
                )}
            </div>

            <slot />

            <div class="mt-5 text-xs text-zinc-400 border-none outline-none bg-transparent">
                {t['spotifyLanding.curatedBy']}{' '}
                <a
                    href="https://tommasoscalici.dev"
                    target="_blank"
                    rel="noopener noreferrer"
                    class="border-b border-transparent bg-transparent font-semibold text-zinc-200 no-underline transition-colors duration-200 outline-none hover:border-white hover:text-white"
                >
                    Tommaso Scalici
                </a>
                <p class="mt-1.5 text-[10px] text-zinc-400">
                    {t['spotifyConsent.disclaimer']}
                    <button
                        type="button"
                        data-open-spotify-consent
                        class="ml-1 cursor-pointer underline hover:text-white transition-colors focus-visible:ring-2 focus-visible:ring-primary focus-visible:outline-none rounded"
                    >
                        {t['spotifyConsent.manage']}
                    </button>
                </p>
            </div>
        </div>
    </div>

    <SpotifyConsentDialog lang={lang} />

    <script>
        const initManageConsent = () => {
            const btns = document.querySelectorAll<HTMLButtonElement>(
                '[data-open-spotify-consent]:not([data-initialized])',
            );
            for (const btn of btns) {
                btn.setAttribute('data-initialized', 'true');
                btn.addEventListener('click', (e) => {
                    e.preventDefault();
                    window.dispatchEvent(new CustomEvent('open-spotify-consent'));
                });
            }
        };

        if (document.readyState === 'loading') {
            document.addEventListener('DOMContentLoaded', initManageConsent);
        } else {
            initManageConsent();
        }
        document.addEventListener('astro:page-load', initManageConsent);
    </script>
</BaseLayout>
