---
import { getImage, Picture } from 'astro:assets';

import { normalizePath } from '../lib/seo';
import BaseLayout from './BaseLayout.astro';

interface Props {
    title: string;
    description: string;
    coverImage: string;
    theme: 'lofi' | 'prog' | 'jrpg';
}

const { title, description, coverImage, theme } = Astro.props;

// 1. High-priority optimized cover for LCP preload & picture tag
const optimizedCover = await getImage({
    src: coverImage,
    format: 'avif',
    width: 300,
    height: 300,
});

// 2. Ultra-lightweight blurred background (64x64 WebP, ~400 bytes instead of ~30KB)
const optimizedBg = await getImage({
    src: coverImage,
    format: 'webp',
    width: 64,
    height: 64,
    quality: 25,
});

// 3. Crisp OpenGraph image for social crawlers (640x640)
const ogImage = await getImage({
    src: coverImage,
    format: 'webp',
    width: 640,
    height: 640,
});

// Canonical URL
const canonicalURL = new URL(normalizePath(Astro.url.pathname), Astro.site);
const themeColor = theme === 'lofi' ? '#0d1117' : theme === 'jrpg' ? '#0a0514' : '#050505';

// Theme Configuration
const themeConfig = {
    prog: {
        bgBlur: 'filter: blur(30px) brightness(0.3);',
        card: 'background: rgba(10, 10, 10, 0.8); backdrop-filter: blur(15px); border: 1px solid rgba(0, 243, 255, 0.2); box-shadow: 0 0 40px rgba(0, 243, 255, 0.1);',
        coverShadow: 'box-shadow: 0 10px 30px rgba(0,0,0,0.6);',
    },
    lofi: {
        bgBlur: 'filter: blur(25px) brightness(0.4);',
        card: 'background: rgba(22, 27, 34, 0.85); backdrop-filter: blur(10px); border: 1px solid rgba(255, 255, 255, 0.1); box-shadow: 0 20px 50px rgba(0,0,0,0.5);',
        coverShadow: 'box-shadow: 0 8px 20px rgba(0,0,0,0.4);',
    },
    jrpg: {
        bgBlur: 'filter: blur(28px) brightness(0.32);',
        card: 'background: rgba(14, 10, 26, 0.85); backdrop-filter: blur(16px); border: 1px solid rgba(244, 63, 94, 0.3); box-shadow: 0 0 45px rgba(225, 29, 72, 0.2), 0 0 25px rgba(168, 85, 247, 0.15);',
        coverShadow: 'box-shadow: 0 12px 35px rgba(0,0,0,0.7);',
    },
};

const currentTheme = themeConfig[theme];
const gradientClasses =
    theme === 'lofi'
        ? 'from-indigo-500 via-sky-500 to-indigo-500'
        : theme === 'jrpg'
          ? 'from-rose-500 via-purple-600 to-amber-400'
          : 'from-primary via-secondary to-primary';
---

<BaseLayout title={title} hideCookieBanner={true} autoConsent={true}>
    <Fragment slot="head">
        <!-- Preload LCP Cover Image -->
        <link
            rel="preload"
            as="image"
            href={optimizedCover.src}
            type="image/avif"
            fetchpriority="high"
        />

        <!-- SEO -->
        <meta name="description" content={description} />
        <meta name="robots" content="noindex, nofollow" />
        <link rel="canonical" href={canonicalURL.toString()} />
        <meta name="theme-color" content={themeColor} />
        <link rel="icon" href="/favicon.ico" sizes="any" />
        <link rel="icon" href="/apple-touch-icon.png" type="image/png" sizes="180x180" />
        <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

        <!-- Open Graph -->
        <meta property="og:title" content={title} />
        <meta property="og:description" content={description} />
        <meta property="og:image" content={ogImage.src} />
        <meta property="og:type" content="music.playlist" />
    </Fragment>

    <div
        class="relative flex h-screen items-center justify-center overflow-hidden font-sans text-white"
        style={
            theme === 'lofi'
                ? 'background-color: #0d1117;'
                : theme === 'jrpg'
                  ? 'background-color: #0a0514;'
                  : 'background-color: #050505;'
        }
    >
        <div
            class="absolute top-0 left-0 -z-10 h-full w-full scale-110 bg-cover bg-center bg-no-repeat"
            style={`${currentTheme.bgBlur} background-image: url('${optimizedBg.src}');`}
        ></div>

        <div
            class="landing-card w-[90%] max-w-95 rounded-3xl p-[30px_20px] text-center"
            style={currentTheme.card}
        >
            <div class="group relative mx-auto mb-5 aspect-square w-full rounded-xl">
                <div
                    class={`absolute -inset-1 animate-spin-slow rounded-xl bg-linear-to-r opacity-75 blur-lg ${gradientClasses}`}
                ></div>
                <Picture
                    src={coverImage}
                    alt={`${title} Cover`}
                    width={300}
                    height={300}
                    formats={['avif', 'webp']}
                    loading="eager"
                    fetchpriority="high"
                    class="relative h-full w-full rounded-xl object-cover"
                    style={currentTheme.coverShadow}
                    inferSize={true}
                />
            </div>

            <slot />

            <div class="mt-5 text-xs text-zinc-400 border-none outline-none bg-transparent">
                Curated by{' '}
                <a
                    href="https://tommasoscalici.dev"
                    target="_blank"
                    rel="noopener noreferrer"
                    class="border-b border-transparent bg-transparent font-semibold text-zinc-200 no-underline transition-colors duration-200 outline-none hover:border-white hover:text-white"
                >
                    Tommaso Scalici
                </a>
                <p class="mt-1.5 text-[10px] text-zinc-400">
                    This page uses cookies for analytics & music deep-linking.
                </p>
            </div>
        </div>
    </div>
</BaseLayout>
