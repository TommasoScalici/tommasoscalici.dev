{
    "name": "tommasoscalici.dev",
    "version": "1.16.1",
    "description": "Personal portfolio and music showcase bridging software engineering and progressive metal.",
    "author": "Tommaso Scalici",
    "license": "MIT",
    "private": true,
    "repository": {
        "type": "git",
        "url": "https://github.com/TommasoScalici/tommasoscalici.dev.git"
    },
    "homepage": "https://tommasoscalici.dev",
    "engines": {
        "node": ">=22.14.0"
    },
    "keywords": [
        "astro",
        "react",
        "portfolio",
        "typescript",
        "music",
        "progressive-metal"
    ],
    "type": "module",
    "scripts": {
        "build": "astro build",
        "check": "astro check",
        "dev": "astro dev",
        "lint": "eslint .",
        "lint:fix": "eslint . --fix",
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "test": "vitest run",
        "test:watch": "vitest",
        "prepare": "husky",
        "preview:cloudflare": "npx wrangler pages deployment tail --project-name=tommasoscalici-dev",
        "preview:local": "npx wrangler pages dev dist"
    },
    "lint-staged": {
        "*.{js,jsx,ts,tsx,astro}": [
            "eslint --fix",
            "prettier --write"
        ],
        "*.{json,md,css}": [
            "prettier --write"
        ]
    },
    "dependencies": {
        "@astrojs/cloudflare": "^12.6.12",
        "@astrojs/react": "^4.4.2",
        "@astrojs/sitemap": "^3.7.0",
        "@astrojs/tailwind": "^6.0.2",
        "@fontsource-variable/inter": "^5.2.8",
        "@fontsource-variable/jetbrains-mono": "^5.2.8",
        "astro": "^5.16.16",
        "astro-seo": "^1.1.0",
        "react": "^19.2.4",
        "react-dom": "^19.2.4",
        "react-icons": "^5.5.0"
    },
    "devDependencies": {
        "@eslint/js": "^9.39.2",
        "@semantic-release/changelog": "^6.0.3",
        "@semantic-release/git": "^10.0.1",
        "@tailwindcss/typography": "^0.5.19",
        "eslint": "^9.39.2",
        "eslint-plugin-astro": "^1.5.0",
        "eslint-plugin-jsx-a11y": "^6.10.2",
        "eslint-plugin-react": "^7.37.5",
        "eslint-plugin-react-hooks": "^7.0.1",
        "eslint-plugin-simple-import-sort": "^12.1.1",
        "globals": "^17.2.0",
        "happy-dom": "^20.4.0",
        "husky": "^9.1.7",
        "lint-staged": "^16.2.7",
        "prettier": "^3.8.1",
        "prettier-plugin-astro": "^0.14.1",
        "prettier-plugin-tailwindcss": "^0.7.2",
        "semantic-release": "^25.0.2",
        "tailwindcss-animate": "^1.0.7",
        "typescript-eslint": "^8.54.0",
        "vitest": "^4.0.18",
        "wrangler": "^4.61.0"
    },
    "overrides": {
        "lodash": "^4.17.21",
        "undici": "^7.19.2",
        "wrangler": "^4.61.0",
        "yargs-parser": "^21.1.1"
    }
}
