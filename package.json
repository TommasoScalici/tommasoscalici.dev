{
    "name": "tommasoscalici.dev",
    "version": "1.20.1",
    "description": "Personal portfolio and music showcase bridging software engineering and progressive metal.",
    "author": "Tommaso Scalici",
    "license": "MIT",
    "private": true,
    "repository": {
        "type": "git",
        "url": "https://github.com/TommasoScalici/tommasoscalici.dev.git"
    },
    "homepage": "https://tommasoscalici.dev",
    "engines": {
        "node": ">=24.12.0"
    },
    "keywords": [
        "astro",
        "portfolio",
        "typescript",
        "music",
        "progressive-metal"
    ],
    "type": "module",
    "scripts": {
        "build": "astro build",
        "check": "astro check",
        "dev": "astro dev",
        "lint": "eslint .",
        "lint:fix": "eslint . --fix",
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "test": "vitest run",
        "test:watch": "vitest",
        "prepare": "husky",
        "preview:cloudflare": "npx wrangler pages deployment tail --project-name=tommasoscalici-dev",
        "preview:local": "npx wrangler pages dev dist"
    },
    "lint-staged": {
        "*.{js,jsx,ts,tsx,astro}": [
            "eslint --fix",
            "prettier --write"
        ],
        "*.{json,md,css}": [
            "prettier --write"
        ]
    },
    "dependencies": {
        "@astrojs/sitemap": "^3.7.2",
        "@fontsource-variable/inter": "^5.2.8",
        "@fontsource-variable/jetbrains-mono": "^5.2.8",
        "@iconify-json/lucide": "^1.2.102",
        "@iconify-json/simple-icons": "^1.2.77",
        "@tailwindcss/typography": "^0.5.19",
        "@tailwindcss/vite": "^4.2.2",
        "astro": "^6.1.5",
        "astro-icon": "^1.1.5",
        "astro-seo": "^1.1.0",
        "tailwindcss": "^4.2.2"
    },
    "devDependencies": {
        "@astrojs/check": "^0.9.8",
        "@eslint/js": "^10.0.1",
        "@semantic-release/changelog": "^6.0.3",
        "@semantic-release/commit-analyzer": "^13.0.1",
        "@semantic-release/git": "^10.0.1",
        "@semantic-release/github": "^12.0.6",
        "@semantic-release/npm": "^13.1.5",
        "@semantic-release/release-notes-generator": "^14.1.0",
        "eslint": "^10.2.0",
        "eslint-plugin-astro": "^1.7.0",
        "eslint-plugin-simple-import-sort": "^13.0.0",
        "globals": "^17.4.0",
        "happy-dom": "^20.8.9",
        "husky": "^9.1.7",
        "lint-staged": "^16.4.0",
        "prettier": "^3.8.2",
        "prettier-plugin-astro": "^0.14.1",
        "prettier-plugin-tailwindcss": "^0.7.2",
        "semantic-release": "^25.0.3",
        "typescript-eslint": "^8.58.1",
        "vitest": "^4.1.4",
        "wrangler": "^4.81.1"
    },
    "overrides": {
        "brace-expansion": "^5.0.5",
        "lodash": "^4.17.23",
        "minimatch": "^10.2.2",
        "picomatch": "^4.0.4",
        "undici": "^7.22.0",
        "vite": "^7",
        "yargs-parser": "^22.0.0",
        "yaml": "^2.8.3"
    }
}
