{
    "name": "tommasoscalici.dev",
    "version": "1.23.0",
    "description": "Personal portfolio and music showcase bridging software engineering and progressive metal.",
    "author": "Tommaso Scalici",
    "license": "MIT",
    "private": true,
    "repository": {
        "type": "git",
        "url": "https://github.com/TommasoScalici/tommasoscalici.dev.git"
    },
    "homepage": "https://tommasoscalici.dev",
    "engines": {
        "node": "24"
    },
    "keywords": [
        "astro",
        "portfolio",
        "typescript",
        "music",
        "progressive-metal"
    ],
    "type": "module",
    "scripts": {
        "build": "astro build",
        "check": "astro check",
        "dev": "astro dev",
        "lint": "eslint .",
        "lint:fix": "eslint . --fix",
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "test": "vitest run",
        "test:watch": "vitest",
        "prepare": "husky",
        "preview:deploy": "npm run build && npx wrangler pages deploy dist",
        "preview:local": "npx wrangler pages dev dist"
    },
    "lint-staged": {
        "*.{js,jsx,ts,tsx,astro}": [
            "eslint --fix",
            "prettier --write"
        ],
        "*.{json,md,css}": [
            "prettier --write"
        ]
    },
    "dependencies": {
        "@astrojs/sitemap": "^3.7.3",
        "@fontsource-variable/inter": "^5.3.0",
        "@fontsource-variable/jetbrains-mono": "^5.3.0",
        "@iconify-json/lucide": "^1.2.121",
        "@iconify-json/simple-icons": "^1.2.92",
        "@tailwindcss/typography": "^0.5.20",
        "@tailwindcss/vite": "^4.3.3",
        "astro": "^7.1.6",
        "astro-icon": "^1.1.5",
        "astro-seo": "^1.1.0",
        "tailwindcss": "^4.3.3"
    },
    "devDependencies": {
        "@astrojs/check": "^0.9.10",
        "@eslint/js": "^10.0.1",
        "@semantic-release/changelog": "^7.0.0",
        "@semantic-release/commit-analyzer": "^13.0.1",
        "@semantic-release/git": "^11.0.1",
        "@semantic-release/github": "^12.0.9",
        "@semantic-release/npm": "^13.1.5",
        "@semantic-release/release-notes-generator": "^14.1.1",
        "eslint": "^10.8.0",
        "eslint-plugin-astro": "^3.0.1",
        "eslint-plugin-simple-import-sort": "^14.0.0",
        "globals": "^17.8.0",
        "happy-dom": "^20.11.1",
        "husky": "^9.1.7",
        "lint-staged": "^17.3.0",
        "prettier": "^3.9.6",
        "prettier-plugin-astro": "^0.14.1",
        "prettier-plugin-tailwindcss": "^0.8.1",
        "semantic-release": "^25.0.8",
        "typescript-eslint": "^8.65.0",
        "vitest": "^4.1.10",
        "wrangler": "^4.118.0"
    },
    "overrides": {
        "brace-expansion": "^5.0.5",
        "lodash": "^4.17.23",
        "minimatch": "^10.2.2",
        "picomatch": "^4.0.4",
        "undici": "^7.22.0",
        "vite": "^8",
        "yargs-parser": "^22.0.0",
        "yaml": "^2.8.3"
    }
}
