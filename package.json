{
    "name": "tommasoscalici.dev",
    "version": "1.18.1",
    "description": "Personal portfolio and music showcase bridging software engineering and progressive metal.",
    "author": "Tommaso Scalici",
    "license": "MIT",
    "private": true,
    "repository": {
        "type": "git",
        "url": "https://github.com/TommasoScalici/tommasoscalici.dev.git"
    },
    "homepage": "https://tommasoscalici.dev",
    "engines": {
        "node": ">=24.12.0"
    },
    "keywords": [
        "astro",
        "portfolio",
        "typescript",
        "music",
        "progressive-metal"
    ],
    "type": "module",
    "scripts": {
        "build": "astro build",
        "check": "astro check",
        "dev": "astro dev",
        "lint": "eslint .",
        "lint:fix": "eslint . --fix",
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "test": "vitest run",
        "test:watch": "vitest",
        "prepare": "husky",
        "preview:cloudflare": "npx wrangler pages deployment tail --project-name=tommasoscalici-dev",
        "preview:local": "npx wrangler pages dev dist"
    },
    "lint-staged": {
        "*.{js,jsx,ts,tsx,astro}": [
            "eslint --fix",
            "prettier --write"
        ],
        "*.{json,md,css}": [
            "prettier --write"
        ]
    },
    "dependencies": {
        "@astrojs/cloudflare": "^12.6.12",
        "@astrojs/sitemap": "^3.7.0",
        "@astrojs/tailwind": "^6.0.2",
        "@fontsource-variable/inter": "^5.2.8",
        "@fontsource-variable/jetbrains-mono": "^5.2.8",
        "@iconify-json/lucide": "^1.2.93",
        "@iconify-json/simple-icons": "^1.2.71",
        "astro": "^5.17.3",
        "astro-icon": "^1.1.5",
        "astro-seo": "^1.1.0"
    },
    "devDependencies": {
        "@astrojs/check": "^0.9.6",
        "@eslint/js": "^10.0.1",
        "@tailwindcss/typography": "^0.5.19",
        "eslint": "^10.0.1",
        "eslint-plugin-astro": "^1.6.0",
        "eslint-plugin-simple-import-sort": "^12.1.1",
        "globals": "^17.3.0",
        "happy-dom": "^20.7.0",
        "husky": "^9.1.7",
        "lint-staged": "^16.2.7",
        "prettier": "^3.8.1",
        "prettier-plugin-astro": "^0.14.1",
        "prettier-plugin-tailwindcss": "^0.7.2",
        "tailwindcss-animate": "^1.0.7",
        "typescript-eslint": "^8.56.0",
        "vitest": "^4.0.18",
        "wrangler": "^4.67.0"
    },
    "overrides": {
        "lodash": "^4.17.23",
        "minimatch": "^10.2.2",
        "undici": "^7.22.0",
        "yargs-parser": "^22.0.0",
        "wrangler": "^4.67.0"
    }
}
