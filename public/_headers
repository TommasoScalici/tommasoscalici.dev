  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline' https://www.googletagmanager.com https://connect.facebook.net https://analytics.tiktok.com https://googleads.g.doubleclick.net https://static.cloudflareinsights.com; style-src 'self' 'unsafe-inline'; img-src 'self' data: https://www.facebook.com https://www.google-analytics.com https://region1.google-analytics.com https://googleads.g.doubleclick.net https://www.google.com https://www.google.it; connect-src 'self' https://www.google-analytics.com https://region1.google-analytics.com https://region1.analytics.google.com https://analytics.tiktok.com https://facebook.com https://www.facebook.com https://analytics-ipv6.tiktokw.us https://stats.g.doubleclick.net; font-src 'self' data: https://fonts.gstatic.com; frame-src 'self' https://open.spotify.com https://www.youtube.com; object-src 'none'; base-uri 'self'; form-action 'self'; upgrade-insecure-requests;
  X-Frame-Options: SAMEORIGIN
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=()
  Strict-Transport-Security: max-age=31536000; includeSubDomains; preload


# Agent Discovery Headers
/*
  Link: <https://tommasoscalici.dev/llms.txt>; rel="llms"
  Link: <https://tommasoscalici.dev/.well-known/api-catalog.json>; rel="api-catalog"
  Link: <https://tommasoscalici.dev/.well-known/openapi.yaml>; rel="service-desc"

# Ensure correct MIME types for machine-readable files
/sitemap-index.xml
  Content-Type: application/xml; charset=utf-8
/sitemap-0.xml
  Content-Type: application/xml; charset=utf-8
/.well-known/api-catalog.json
  Content-Type: application/json; charset=utf-8
/.well-known/mcp/config.json
  Content-Type: application/json; charset=utf-8

# Cache other static assets for 1 week
/*.webp
  Cache-Control: public, max-age=604800
/*.png
  Cache-Control: public, max-age=604800
/*.jpg
  Cache-Control: public, max-age=604800
/*.ico
  Cache-Control: public, max-age=604800

# Cache hashed static assets (JS, CSS) for 1 year (immutable)
/_astro/*
  Cache-Control: public, max-age=31536000, immutable

# HTML pages - short cache with revalidation
/*.html
  Cache-Control: public, max-age=3600, must-revalidate

# Root HTML - short cache with revalidation
/
  Cache-Control: public, max-age=3600, must-revalidate
